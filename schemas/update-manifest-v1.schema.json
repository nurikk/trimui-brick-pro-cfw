{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trimui.invalid/schemas/update-manifest-v1.schema.json",
  "title": "TG4040 userspace update manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "manifestVersion",
    "artifactUrl",
    "artifactName",
    "deviceId",
    "targetSku",
    "hardwareRevision",
    "sourceRelease",
    "releaseId",
    "stockFirmware",
    "userspaceAbi",
    "dataSchema",
    "payloadType",
    "payloadSize",
    "payloadSha256",
    "requiredFreeBytes",
    "userDataManifest"
  ],
  "properties": {
    "$schema": {
      "const": "https://trimui.invalid/schemas/update-manifest-v1.schema.json"
    },
    "manifestVersion": {
      "const": 1
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "targetSku": {
      "const": "TG4040"
    },
    "hardwareRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "sourceRelease": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,46}[a-z0-9])?$",
      "maxLength": 48
    },
    "releaseId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,46}[a-z0-9])?$",
      "maxLength": 48
    },
    "artifactUrl": {
      "type": "string",
      "pattern": "^https://[^@\\s/?#\\\\]+/[^\\s?#\\\\]+$",
      "maxLength": 2048
    },
    "artifactName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "maxLength": 128
    },
    "stockFirmware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "max": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    },
    "userspaceAbi": {
      "const": "tg4040-userspace-v1"
    },
    "dataSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "payloadType": {
      "const": "squashfs-userspace"
    },
    "payloadSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requiredFreeBytes": {
      "type": "integer",
      "minimum": 3,
      "maximum": 1610612736
    },
    "userDataManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schemaVersion", "entries"],
      "properties": {
        "format": {"const": "update-user-data-manifest"},
        "schemaVersion": {"const": 1},
        "entries": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["class", "path", "sourceSchema", "targetSchema", "migration"],
            "properties": {
              "class": {"enum": ["saves", "credentials", "achievements", "mappings", "fn-led-settings", "service-settings", "emulator-selections"]},
              "path": {"enum": ["data/saves", "data/credentials", "data/achievements", "data/mappings", "data/settings/fn-led", "data/settings/services", "data/settings/emulator-selections"]},
              "sourceSchema": {"type": "integer", "minimum": 1, "maximum": 1000},
              "targetSchema": {"type": "integer", "minimum": 1, "maximum": 1000},
              "migration": {"const": "shared-data-copy-on-write"}
            }
          }
        }
      }
    }
  }
}
