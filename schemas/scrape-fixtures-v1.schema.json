{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-brick-scrape-fixtures-v1.schema.json",
  "title": "Synthetic metadata scraper journeys v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "synthetic", "provider", "journeys"],
  "properties": {
    "$schema": {"const": "https://example.invalid/trimui-brick-scrape-fixtures-v1.schema.json"},
    "schema": {"const": "metadata-scraper-fixtures/v1"},
    "synthetic": {"const": true},
    "provider": {"const": "fixture"},
    "journeys": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/journey"}}
  },
  "$defs": {
    "journey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contentId", "systemId", "expected"],
      "properties": {
        "contentId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "systemId": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"},
        "expected": {"enum": ["succeeded", "not-found", "ambiguous", "retry-then-succeeded", "retry-after-then-succeeded", "manual-search"]}
      }
    }
  }
}
