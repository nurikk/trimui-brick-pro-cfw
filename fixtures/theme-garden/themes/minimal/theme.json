{
  "$schema": "urn:project:theme-v1",
  "format": "theme-v1",
  "schemaVersion": 1,
  "metadata": {
    "name": "Minimal Grid",
    "author": "Project Authors",
    "license": "MIT",
    "provenance": "project-authored"
  },
  "canvas": { "width": 1024, "height": 768, "aspect": "4:3" },
  "colors": {
    "background": "#E8E6DF",
    "surface": "#D2D0C8",
    "accent": "#34495E",
    "text": "#17202A",
    "muted": "#AAA79F",
    "highlight": "#D35400"
  },
  "resources": {
    "font": { "kind": "builtin", "ref": "generated-sans", "budgetBytes": 0 },
    "icon": { "kind": "generated", "ref": "controller-mark", "budgetBytes": 0 },
    "background": { "kind": "generated", "ref": "flat-field", "budgetBytes": 0 },
    "sound": { "kind": "builtin", "ref": "silent", "budgetBytes": 0 }
  },
  "layout": {
    "preset": "minimal",
    "maxVisibleGames": 6,
    "regions": [
      { "id": "system-art", "kind": "system-art", "x": 48, "y": 80, "width": 320, "height": 224, "visible": true },
      { "id": "game-list", "kind": "game-list", "x": 400, "y": 80, "width": 576, "height": 224, "visible": true },
      { "id": "box-art", "kind": "box-art-placeholder", "x": 48, "y": 344, "width": 160, "height": 192, "visible": true },
      { "id": "screenshot", "kind": "screenshot-placeholder", "x": 232, "y": 344, "width": 272, "height": 152, "visible": true },
      { "id": "metadata", "kind": "metadata", "x": 528, "y": 344, "width": 448, "height": 192, "visible": true },
      { "id": "menu", "kind": "menu", "x": 48, "y": 568, "width": 928, "height": 80, "visible": true },
      { "id": "help", "kind": "help-strip", "x": 48, "y": 680, "width": 680, "height": 40, "visible": true },
      { "id": "clock", "kind": "clock", "x": 760, "y": 16, "width": 96, "height": 32, "visible": true },
      { "id": "battery", "kind": "battery", "x": 872, "y": 16, "width": 104, "height": 32, "visible": true }
    ]
  },
  "settings": {
    "artworkMode": "screenshot",
    "metadataVisibility": "compact",
    "fontScale": 90,
    "colorScheme": "minimal"
  },
  "fallback": { "splash": "generated-neutral", "onInvalid": "safe-artbook" }
}
