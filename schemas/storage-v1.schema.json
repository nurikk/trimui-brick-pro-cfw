{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-storage-v1.schema.json",
  "title": "Brick Pro logical storage layout v1",
  "description": "Closed, host-simulator storage metadata. It contains no device path, ROM, BIOS, or eMMC operation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "installationUuid", "activeDataVersion", "completedMigrations", "filesystem", "migrationDescriptor"],
  "properties": {
    "$schema": {"const": "https://example.invalid/trimui-storage-v1.schema.json"},
    "format": {"const": "brickpro-storage-layout"},
    "schemaVersion": {"const": 1},
    "installationUuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "activeDataVersion": {"type": "integer", "minimum": 1, "maximum": 1000},
    "completedMigrations": {
      "type": "array", "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "filesystem": {"$ref": "#/$defs/filesystem"},
    "migrationDescriptor": {"type": "string", "pattern": "^data/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$", "maxLength": 256},
    "sd2Uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  },
  "$defs": {
    "filesystem": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "maxFileBytes", "maxPathBytes", "maxComponentBytes", "caseSensitive", "supportsAtomicRename", "supportsFileSync", "supportsDirectorySync", "supportsSymlinks", "supportsPosixOwnership", "supportsPosixModes"],
      "properties": {
        "kind": {"enum": ["fat32", "exfat"]},
        "maxFileBytes": {"type": "integer", "minimum": 1, "maximum": 17592186044415},
        "maxPathBytes": {"type": "integer", "minimum": 32, "maximum": 4096},
        "maxComponentBytes": {"type": "integer", "minimum": 8, "maximum": 255},
        "caseSensitive": {"const": false},
        "supportsAtomicRename": {"type": "boolean"},
        "supportsFileSync": {"type": "boolean"},
        "supportsDirectorySync": {"type": "boolean"},
        "supportsSymlinks": {"const": false},
        "supportsPosixOwnership": {"const": false},
        "supportsPosixModes": {"const": false}
      }
    }
  }
}
