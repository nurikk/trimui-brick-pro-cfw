{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-snapshot-v1",
  "title": "Artbook UI semantic snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "route", "menu", "preferences", "layout", "affordances", "contractStates"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": { "const": "Artbook" },
    "route": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9-]+$" },
    "menu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullScreen", "controllerFirst", "selected", "enabled"],
      "properties": {
        "fullScreen": { "const": true },
        "controllerFirst": { "const": true },
        "selected": { "type": "string", "minLength": 1, "maxLength": 80 },
        "enabled": { "type": "boolean" }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artworkMode", "metadataVisibility", "fontScale", "colorScheme"],
      "properties": {
        "artworkMode": { "enum": ["large", "compact", "off"] },
        "metadataVisibility": { "enum": ["full", "compact", "hidden"] },
        "fontScale": { "enum": ["small", "standard", "large"] },
        "colorScheme": { "enum": ["ink", "paper", "high-contrast"] }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatio", "logicalWidth", "logicalHeight"],
      "properties": {
        "aspectRatio": { "const": "four-by-three" },
        "logicalWidth": { "type": "integer", "minimum": 160, "maximum": 4096 },
        "logicalHeight": { "type": "integer", "minimum": 120, "maximum": 4096 }
      }
    },
    "affordances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock", "battery"],
      "properties": {
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible", "value"],
          "properties": {
            "visible": { "type": "boolean" },
            "value": { "type": "string", "maxLength": 32 }
          }
        },
        "battery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible", "percent", "charging"],
          "properties": {
            "visible": { "type": "boolean" },
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "charging": { "type": "boolean" }
          }
        }
      }
    },
    "contractStates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9-]+$" }
    }
  }
}
