#!/bin/sh
set -eu

RUN=$(mktemp -d /tmp/trimui-demo-XXXXXX)
trap 'rm -rf "$RUN"' EXIT

./scripts/sim run --backend=x11 --run-dir "$RUN" --wait-ready 30 --detach
# The canonical host profile starts the fourth entry, signal-workshop.
for frame in 1 2 3; do
    ./scripts/simctl --socket "$RUN/control.sock" screenshot --name "signal-$frame"
    [ "$frame" -eq 3 ] || ./scripts/simctl --socket "$RUN/control.sock" button --button right --action press
done
./scripts/simctl --socket "$RUN/control.sock" adapter complete --status 0 --value 0

# Return to the library after each broker-backed session, then select the next entry.
./scripts/simctl --socket "$RUN/control.sock" button --button start --action press
./scripts/simctl --socket "$RUN/control.sock" button --button down --action press
for _ in 1 2 3; do ./scripts/simctl --socket "$RUN/control.sock" button --button up --action press; done
./scripts/simctl --socket "$RUN/control.sock" button --button primary --action press
for frame in 1 2 3; do
    ./scripts/simctl --socket "$RUN/control.sock" screenshot --name "nebula-$frame"
    [ "$frame" -eq 3 ] || ./scripts/simctl --socket "$RUN/control.sock" button --button right --action press
done
./scripts/simctl --socket "$RUN/control.sock" adapter complete --status 0 --value 0

./scripts/simctl --socket "$RUN/control.sock" button --button start --action press
./scripts/simctl --socket "$RUN/control.sock" button --button down --action press
./scripts/simctl --socket "$RUN/control.sock" button --button down --action press
./scripts/simctl --socket "$RUN/control.sock" button --button primary --action press
for frame in 1 2 3; do
    ./scripts/simctl --socket "$RUN/control.sock" screenshot --name "mirror-$frame"
    [ "$frame" -eq 3 ] || ./scripts/simctl --socket "$RUN/control.sock" button --button right --action press
done
./scripts/simctl --socket "$RUN/control.sock" adapter complete --status 0 --value 0

./scripts/simctl --socket "$RUN/control.sock" button --button start --action press
./scripts/simctl --socket "$RUN/control.sock" button --button down --action press
./scripts/simctl --socket "$RUN/control.sock" button --button down --action press
./scripts/simctl --socket "$RUN/control.sock" button --button primary --action press
for frame in 1 2 3; do
    ./scripts/simctl --socket "$RUN/control.sock" screenshot --name "orbit-$frame"
    [ "$frame" -eq 3 ] || ./scripts/simctl --socket "$RUN/control.sock" button --button right --action press
done
./scripts/simctl --socket "$RUN/control.sock" adapter complete --status 0 --value 0
./scripts/sim stop --run-dir "$RUN"

python3 - "$RUN" <<'PY'
import hashlib
import struct
import sys

for demo in ("orbit", "signal", "mirror", "nebula"):
    frames = [
        open(f"{sys.argv[1]}/screenshots/{demo}-{n}.png", "rb").read()
        for n in (1, 2, 3)
    ]
    assert len({hashlib.sha256(frame).digest() for frame in frames}) == 3
    assert all(struct.unpack(">II", frame[16:24]) == (1024, 768) for frame in frames)
print('{"headedGames":4,"changedFramesPerGame":2,"result":"pass"}')
PY
