{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "launcher-presentation-v1",
  "title": "Generated Artbook launcher presentation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "identity", "route", "focus", "title", "selectedLabel", "menu", "gameRows", "resume", "selectedGame", "gameMedia", "systemMedia", "regions", "palette", "theme", "themeFallback", "generatedAssets", "settings", "wifi", "scraper", "modal", "splash", "affordances", "controllerHelp", "groupJump", "index", "boundaries", "saveSync", "uiSize"],
  "properties": {
    "schema": {"const": "launcher-presentation/v1"},
    "identity": {"const": "Artbook"},
    "route": {"type": "string", "pattern": "^[a-z0-9-]{1,48}$"},
    "focus": {"type": "string", "pattern": "^[a-z0-9-]{1,48}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 80},
    "selectedLabel": {"type": "string", "maxLength": 128},
    "uiSize": {"enum": ["automatic", "small", "medium", "large", "extra-large"]},
    "menu": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/item"}},
    "gameRows": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/item"}},
    "resume": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["contentId", "label", "status", "timestampMs", "screenshot", "choices"], "properties": {"contentId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}, "label": {"type": "string", "maxLength": 128}, "status": {"type": "string", "maxLength": 48}, "timestampMs": {"type": "integer", "minimum": 1}, "screenshot": {"type": "string", "pattern": "^generated-[a-z0-9-]+$"}, "choices": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 32}}}}},
    "selectedGame": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/game"}]},
    "gameMedia": {"type": "array", "maxItems": 16, "items": {"$ref": "#/$defs/media"}},
    "systemMedia": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/media"}]},
    "regions": {"type": "array", "minItems": 9, "maxItems": 16, "items": {"$ref": "#/$defs/region"}},
    "palette": {"$ref": "#/$defs/palette"},
    "theme": {"type": "object"},
    "themeFallback": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 48}]},
    "generatedAssets": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/asset"}},
    "settings": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "wifi": {"oneOf": [{"type": "null"}, {"type": "object"}]},
    "scraper": {"$ref": "#/$defs/scraper"},
    "modal": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]},
    "splash": {"type": "string", "minLength": 1, "maxLength": 80},
    "affordances": {"$ref": "#/$defs/affordances"},
    "controllerHelp": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["button", "label"], "properties": {"button": {"enum": ["up", "down", "left", "right", "primary", "secondary", "start", "select", "l1", "r1", "menu"]}, "label": {"type": "string", "maxLength": 64}, "action": {"oneOf": [{"type": "null"}, {"enum": ["move-up", "move-down", "move-left", "move-right", "primary", "secondary", "start", "select", "jump-next-group", "jump-previous-group"]}]}}}}, "groupJump": {"type": "object", "additionalProperties": false, "required": ["current", "target", "visible"], "properties": {"current": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 32}]}, "target": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 32}]}, "visible": {"type": "boolean"}}}, "index": {"type": "object", "additionalProperties": false, "required": ["status", "entryCount", "visibleRows", "searchResults", "queueDepth"], "properties": {"status": {"type": "string"}, "entryCount": {"type": "integer"}, "visibleRows": {"type": "integer"}, "searchResults": {"type": "integer"}, "queueDepth": {"type": "integer"}}}, "boundaries": {"type": "object", "additionalProperties": false, "required": ["metadataScraper", "mediaCache", "wifiController", "themeGarden", "updateAgent"], "properties": {"metadataScraper": {"$ref": "#/$defs/boundary"}, "mediaCache": {"$ref": "#/$defs/boundary"}, "wifiController": {"$ref": "#/$defs/boundary"}, "themeGarden": {"$ref": "#/$defs/boundary"}, "updateAgent": {"$ref": "#/$defs/boundary"}}}, "saveSync": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["local", "remote", "state", "transportOutcome", "actions"], "properties": {"local": {"$ref": "#/$defs/saveSyncCandidate"}, "remote": {"$ref": "#/$defs/saveSyncCandidate"}, "state": {"type": "string"}, "transportOutcome": {"type": "string"}, "actions": {"type": "array", "items": {"enum": ["keep-local", "keep-remote", "keep-both"]}}}}]}
  },
  "$defs": {
    "item": {"type": "object", "additionalProperties": false, "required": ["id", "label", "selected", "enabled"], "properties": {"id": {"type": "string", "maxLength": 128}, "label": {"type": "string", "maxLength": 128}, "selected": {"type": "boolean"}, "enabled": {"type": "boolean"}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "altText"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "kind": {"enum": ["system-artwork", "system-logo", "box-art", "screenshot", "splash", "fallback"]}, "altText": {"type": "string", "maxLength": 160}}},
    "media": {"type": "object", "additionalProperties": false, "required": ["contentId", "kind", "path", "width", "height"], "properties": {"contentId": {"type": "string"}, "kind": {"enum": ["system-art", "box-art", "screenshot"]}, "path": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "region": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "x", "y", "width", "height", "visible"], "properties": {"id": {"type": "string", "maxLength": 32}, "kind": {"type": "string", "maxLength": 48}, "x": {"type": "integer", "minimum": 0, "maximum": 1023}, "y": {"type": "integer", "minimum": 0, "maximum": 767}, "width": {"type": "integer", "minimum": 1, "maximum": 1024}, "height": {"type": "integer", "minimum": 1, "maximum": 768}, "visible": {"type": "boolean"}}},
    "palette": {"type": "object", "additionalProperties": false, "required": ["background", "surface", "accent", "text", "muted", "highlight"], "properties": {"background": {"$ref": "#/$defs/color"}, "surface": {"$ref": "#/$defs/color"}, "accent": {"$ref": "#/$defs/color"}, "text": {"$ref": "#/$defs/color"}, "muted": {"$ref": "#/$defs/color"}, "highlight": {"$ref": "#/$defs/color"}}},
    "color": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}, {"const": 255}], "minItems": 4, "maxItems": 4},
    "game": {"type": "object", "additionalProperties": false, "required": ["id", "title", "description", "rating", "releaseDate", "boxArt", "screenshot", "favorite"], "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}, "title": {"type": "string"}, "description": {"type": "string"}, "rating": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 100}]}, "releaseDate": {"oneOf": [{"type": "null"}, {"type": "string"}]}, "boxArt": {"$ref": "#/$defs/asset"}, "screenshot": {"$ref": "#/$defs/asset"}, "favorite": {"type": "boolean"}}},
    "scraper": {"type": "object", "additionalProperties": false, "required": ["route", "status", "queueCount", "completed", "total", "progressPercent", "configuredSlots", "paused", "pausedReason", "background", "counts", "rows", "actions", "cancelRequested", "ambiguousCandidates"], "properties": {"route": {"type": "string", "maxLength": 48}, "status": {"type": "string", "maxLength": 48}, "queueCount": {"type": "integer", "minimum": 0}, "completed": {"type": "integer", "minimum": 0, "maximum": 65535}, "total": {"type": "integer", "minimum": 0, "maximum": 65535}, "progressPercent": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0, "maximum": 100}]}, "configuredSlots": {"type": "integer", "minimum": 0, "maximum": 255}, "paused": {"type": "boolean"}, "pausedReason": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]}, "background": {"type": "boolean"}, "counts": {"$ref": "#/$defs/scraperCounts"}, "rows": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/scraperRow"}}, "actions": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 32}}, "cancelRequested": {"type": "boolean"}, "ambiguousCandidates": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 128}}}},
    "scraperCounts": {"type": "object", "additionalProperties": false, "required": ["succeeded", "fallback", "notFound", "ambiguous", "failed", "cancelled"], "properties": {"succeeded": {"type": "integer", "minimum": 0, "maximum": 65535}, "fallback": {"type": "integer", "minimum": 0, "maximum": 65535}, "notFound": {"type": "integer", "minimum": 0, "maximum": 65535}, "ambiguous": {"type": "integer", "minimum": 0, "maximum": 65535}, "failed": {"type": "integer", "minimum": 0, "maximum": 65535}, "cancelled": {"type": "integer", "minimum": 0, "maximum": 65535}}},
    "scraperRow": {"type": "object", "additionalProperties": false, "required": ["gameId", "title", "provider", "phase", "fallbackTransition"], "properties": {"gameId": {"type": "string", "maxLength": 128}, "title": {"type": "string", "maxLength": 128}, "provider": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 64}]}, "phase": {"enum": ["searching", "retrying", "falling-back", "downloading-cover", "publishing", "done"]}, "fallbackTransition": {"oneOf": [{"type": "null"}, {"type": "string", "maxLength": 128}]}}},
    "affordances": {"type": "object", "additionalProperties": false, "required": ["clock", "batteryPercent", "charging"], "properties": {"clock": {"type": "string", "maxLength": 32}, "batteryPercent": {"type": "integer", "minimum": 0, "maximum": 100}, "charging": {"type": "boolean"}}},
    "boundary": {"type": "object", "additionalProperties": false, "required": ["available", "state"], "properties": {"available": {"type": "boolean"}, "state": {"type": "string"}}},
    "saveSyncCandidate": {"type": "object", "additionalProperties": false, "required": ["logicalId", "contentId", "deviceId", "deviceName", "generation", "hashPrefix", "parentHashPrefix", "ancestry", "saveKind", "timestampMs", "size", "status", "deleted"], "properties": {"logicalId": {"type": "string"}, "contentId": {"type": "string"}, "deviceId": {"type": "string"}, "deviceName": {"type": "string"}, "generation": {"type": "integer", "minimum": 1}, "hashPrefix": {"type": "string", "minLength": 12, "maxLength": 12}, "parentHashPrefix": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 12, "maxLength": 12}]}, "ancestry": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 12, "maxLength": 12}}, "saveKind": {"enum": ["sram", "save", "state", "declaredstate"]}, "timestampMs": {"type": "integer", "minimum": 1}, "size": {"type": "integer", "minimum": 0}, "status": {"type": "string"}, "deleted": {"type": "boolean"}}}
  }
}
