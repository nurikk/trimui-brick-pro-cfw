{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-tg4040-core-pack-v1.schema.json",
  "title": "TG4040 stable core-pack contract v1",
  "description": "Closed metadata-only contract. It contains no runner, core, package, artifact, BIOS, ROM, or license payload.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "kind", "id", "version", "targetSku", "channel", "status", "blockedReason", "package", "runner", "systems", "routing", "defaults", "displayPrecedence", "inputPrecedence", "provenance"],
  "properties": {
    "$schema": {"const": "https://example.invalid/trimui-tg4040-core-pack-v1.schema.json"},
    "format": {"const": "trimui-tg4040-core-pack"},
    "schemaVersion": {"const": 1},
    "kind": {"const": "core-pack"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"$ref": "#/$defs/version"},
    "targetSku": {"const": "TG4040"},
    "channel": {"const": "stable"},
    "status": {"const": "blocked"},
    "blockedReason": {"type": "string", "minLength": 1, "maxLength": 512},
    "package": {"$ref": "#/$defs/identity"},
    "runner": {"$ref": "#/$defs/identity"},
    "systems": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/system"}},
    "routing": {"$ref": "#/$defs/routing"},
    "defaults": {"$ref": "#/$defs/defaults"},
    "displayPrecedence": {"const": ["system", "profile", "game", "reset"]},
    "inputPrecedence": {"const": ["built-in", "system", "game", "session"]},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "targetArchitecture", "manifest", "artifact", "status", "blockedReason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"$ref": "#/$defs/version"},
        "targetArchitecture": {"const": "aarch64-unknown-linux-musl"},
        "manifest": {"$ref": "#/$defs/hashState"},
        "artifact": {"$ref": "#/$defs/hashState"},
        "status": {"const": "blocked"},
        "blockedReason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "bios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "required", "expectedSha256", "status", "blockedReason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "required": {"const": true},
        "expectedSha256": {"type": "null"},
        "status": {"const": "blocked"},
        "blockedReason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sharedExtensions"],
      "properties": {
        "mode": {"const": "explicit-system-selection"},
        "sharedExtensions": {"const": ["zip"]}
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "extensions", "core", "packageId", "packageVersion", "biosRequirements", "status", "blockedReason"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+_-]{0,15}$"}},
        "core": {"$ref": "#/$defs/identity"},
        "packageId": {"$ref": "#/$defs/id"},
        "packageVersion": {"$ref": "#/$defs/version"},
        "biosRequirements": {"type": "array", "items": {"$ref": "#/$defs/bios"}},
        "status": {"const": "blocked"},
        "blockedReason": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display", "frameSkip", "rumble", "audioLatencyMs", "inputProfileId"],
      "properties": {
        "display": {
          "type": "object", "additionalProperties": false, "required": ["width", "height", "scaling", "shader", "overlay"],
          "properties": {"width": {"const": 1024}, "height": {"const": 768}, "scaling": {"const": "integer"}, "shader": {"type": "null"}, "overlay": {"type": "null"}}
        },
        "frameSkip": {"const": 0},
        "rumble": {"const": false},
        "audioLatencyMs": {"type": "integer", "minimum": 1, "maximum": 250},
        "inputProfileId": {"const": "default"}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["status", "blockedReason"],
      "properties": {"status": {"const": "blocked"}, "blockedReason": {"type": "string", "minLength": 1, "maxLength": 512}}
    }
  }
}
