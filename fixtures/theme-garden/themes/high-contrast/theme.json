{
  "$schema": "urn:project:theme-v1",
  "format": "theme-v1",
  "schemaVersion": 1,
  "metadata": {
    "name": "High Contrast",
    "author": "Project Authors",
    "license": "MIT",
    "provenance": "project-authored"
  },
  "canvas": { "width": 1024, "height": 768, "aspect": "4:3" },
  "colors": {
    "background": "#000000",
    "surface": "#181818",
    "accent": "#0055FF",
    "text": "#FFFFFF",
    "muted": "#404040",
    "highlight": "#FFFF00"
  },
  "resources": {
    "font": { "kind": "builtin", "ref": "generated-sans", "budgetBytes": 0 },
    "icon": { "kind": "generated", "ref": "controller-mark", "budgetBytes": 0 },
    "background": { "kind": "generated", "ref": "grid-gradient", "budgetBytes": 0 },
    "sound": { "kind": "builtin", "ref": "silent", "budgetBytes": 0 }
  },
  "layout": {
    "preset": "contrast",
    "maxVisibleGames": 10,
    "regions": [
      { "id": "system-art", "kind": "system-art", "x": 20, "y": 68, "width": 390, "height": 260, "visible": true },
      { "id": "game-list", "kind": "game-list", "x": 430, "y": 68, "width": 574, "height": 260, "visible": true },
      { "id": "box-art", "kind": "box-art-placeholder", "x": 20, "y": 350, "width": 190, "height": 200, "visible": true },
      { "id": "screenshot", "kind": "screenshot-placeholder", "x": 230, "y": 350, "width": 290, "height": 164, "visible": true },
      { "id": "metadata", "kind": "metadata", "x": 540, "y": 350, "width": 464, "height": 200, "visible": true },
      { "id": "menu", "kind": "menu", "x": 20, "y": 580, "width": 984, "height": 90, "visible": true },
      { "id": "help", "kind": "help-strip", "x": 20, "y": 696, "width": 720, "height": 40, "visible": true },
      { "id": "clock", "kind": "clock", "x": 770, "y": 10, "width": 100, "height": 40, "visible": true },
      { "id": "battery", "kind": "battery", "x": 884, "y": 10, "width": 120, "height": 40, "visible": true }
    ]
  },
  "settings": {
    "artworkMode": "box-art",
    "metadataVisibility": "full",
    "fontScale": 120,
    "colorScheme": "high-contrast"
  },
  "fallback": { "splash": "generated-neutral", "onInvalid": "safe-artbook" }
}
