#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)

emit_error() {
    printf '%s\n' "{\"version\":\"sim-control/v1\",\"id\":\"\",\"ok\":false,\"result\":null,\"error\":{\"code\":\"$1\",\"message\":\"$2\"}}"
    exit "$3"
}

command -v sha256sum >/dev/null 2>&1 || emit_error unavailable "sha256sum is required" 3
command -v timeout >/dev/null 2>&1 || emit_error unavailable "timeout is required" 3
CONTROL_TIMEOUT_SECONDS=10

docker_with_timeout() { timeout "$CONTROL_TIMEOUT_SECONDS" docker "$@"; }

. "$ROOT/scripts/docker-worktree.sh"
DOCKER_NAMESPACE=$(trimui_docker_namespace "$ROOT") || emit_error usage "invalid Docker namespace" 2
ROOT_FINGERPRINT=$(trimui_root_fingerprint "$ROOT") || emit_error unavailable "cannot fingerprint repository root" 3
SIMULATOR_LABEL=org.trimui-brick-pro-cfw.simulator=host-native
WORKTREE_LABEL=org.trimui-brick-pro-cfw.worktree=${DOCKER_NAMESPACE}
ROOT_LABEL=org.trimui-brick-pro-cfw.worktree-root-sha256=${ROOT_FINGERPRINT}
CACHE_LABEL=org.trimui-brick-pro-cfw.cache-scope=${DOCKER_NAMESPACE}

usage() { emit_error usage "invalid simctl arguments" 2; }

[ "$#" -ge 2 ] || usage
if [ "$1" = "--socket" ]; then
    shift
    [ "$#" -gt 0 ] || usage
    SOCKET=$1
    shift
elif case "$1" in --socket=*) true ;; *) false ;; esac; then
    SOCKET=${1#--socket=}
    shift
else
    usage
fi
[ -n "$SOCKET" ] || usage
case "$SOCKET" in /*) ;; *) emit_error usage "socket must be an absolute path" 2 ;; esac
[ "$(basename -- "$SOCKET")" = control.sock ] || emit_error usage "socket must be RUN/control.sock" 2
RUN_DIR=$(dirname -- "$SOCKET")
[ -d "$RUN_DIR" ] || emit_error unavailable "run directory is unavailable" 3
RUN_REAL=$(CDPATH= cd -- "$RUN_DIR" && pwd -P) || emit_error unavailable "run directory is unavailable" 3
case "$RUN_REAL" in "$ROOT"|"$ROOT"/*) emit_error usage "run directory must be outside the repository" 2 ;; esac
[ ${#RUN_REAL} -le 87 ] || emit_error usage "run directory is too long for control.sock" 2
SOCKET="$RUN_REAL/control.sock"
NAME=$(printf '%s' "$RUN_REAL" | cksum | awk -v docker_ns="$DOCKER_NAMESPACE" '{print "trimui-sim-" docker_ns "-" $1}')

verify_container() {
    docker_with_timeout inspect "$NAME" 2>/dev/null | python3 -c '
import json, os, sys
try:
    record = json.load(sys.stdin)[0]
    for label in sys.argv[2:]:
        label_key, label_value = label.split("=", 1)
        if record.get("Config", {}).get("Labels", {}).get(label_key) != label_value: raise ValueError
    if record.get("State", {}).get("Running") is not True: raise ValueError
    mounts = [mount for mount in record.get("Mounts", []) if mount.get("Destination") == "/evidence"]
    if len(mounts) != 1 or os.path.realpath(mounts[0].get("Source", "")) != os.path.realpath(sys.argv[1]): raise ValueError
except (IndexError, OSError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
' "$RUN_REAL" "$SIMULATOR_LABEL" "$WORKTREE_LABEL" "$ROOT_LABEL" "$CACHE_LABEL"
}

validate_name() {
    case "$1" in
        ''|[!A-Za-z0-9]*|*[!A-Za-z0-9_-]*) usage ;;
    esac
    [ ${#1} -le 48 ] || usage
}

validate_version() {
    case "$1" in
        ''|*[!0-9.]*|*.*.*.*|.*|*.|*..*) usage ;;
    esac
    [ ${#1} -le 48 ] || usage
}

validate_button() {
    case "$1" in up|down|left|right|primary|secondary|start|select|l1|r1|menu) ;; *) usage ;; esac
}

validate_semantic_action() {
    case "$1" in jump-next-group|jump-previous-group) ;; *) usage ;; esac
}

validate_bool() { case "$1" in true|false) ;; *) usage ;; esac; }

validate_hardware() {
    key=${1%%=*}
    value=${1#*=}
    [ "$key" != "$1" ] || usage
    case "$key" in
        battery.percent)
            case "$value" in ''|*[!0-9]*) usage ;; esac
            [ "$value" -le 100 ] || usage ;;
        battery.available|battery.charging|battery.full|battery.externalPower|radio.enabled|radio.connected) validate_bool "$value" ;;
        battery.health) case "$value" in good|degraded|unknown) ;; *) usage ;; esac ;;
        storage.mode) case "$value" in available|full) ;; *) usage ;; esac ;;
        *) usage ;;
    esac
}

validate_command() {
    command=$1
    shift
    case "$command" in
        wait-ready)
            [ "$#" -eq 2 ] && [ "$1" = --timeout ] || usage
            case "$2" in ''|*[!0-9]*) usage ;; esac
            [ "$2" -gt 0 ] && [ "$2" -le 30 ] || usage ;;
        state) [ "$#" -eq 0 ] || usage ;;
        button)
            [ "$#" -eq 4 ] && [ "$1" = --button ] && [ "$3" = --action ] || usage
            validate_button "$2"
            case "$4" in press|release) ;; *) usage ;; esac ;;
        action)
            [ "$#" -eq 2 ] || { [ "$#" -eq 4 ] && [ "$3" = --phase ] || usage; }
            [ "$1" = --action ] || usage
            validate_semantic_action "$2"
            if [ "$#" -eq 4 ]; then case "$4" in press|release) ;; *) usage ;; esac; fi ;;
        power)
            case "$1" in
                override)
                    [ "$#" -eq 3 ] && [ "$2" = --profile ] || usage
                    case "$3" in eco|balanced|performance) ;; *) usage ;; esac ;;
                temperature)
                    [ "$#" -eq 3 ] && [ "$2" = --celsius ] || usage
                    case "$3" in -[0-9]*|[0-9]*) ;; *) usage ;; esac
                    case "$3" in *[!0-9-]*) usage ;; esac
                    [ "$3" -ge -20 ] && [ "$3" -le 150 ] || usage ;;
                battery-policy)
                    [ "$#" -eq 11 ] || usage
                    [ "$2" = --warning ] && [ "$4" = --critical ] && [ "$6" = --action ] \
                        && [ "$8" = --charging-led ] && [ "${10}" = --charging-display ] || usage
                    case "$3:$5" in *[!0-9:]*|:*|*:) usage ;; esac
                    [ "$3" -le 50 ] && [ "$5" -gt 0 ] && [ "$5" -lt "$3" ] || usage
                    case "$7" in warn-only|save-and-exit|exit-without-save) ;; *) usage ;; esac
                    validate_bool "$9"
                    validate_bool "${11}" ;;
                *) usage ;;
            esac ;;
        hardware)
            [ "$#" -ge 2 ] && [ "$1" = set ] || usage
            shift
            for assignment do validate_hardware "$assignment"; done ;;
        fault)
            [ "$#" -eq 2 ] || usage
            case "$1" in set|clear) ;; *) usage ;; esac
            case "$2" in adapter-fail|adapter-crash|input-drop|suspend-fail|checkpoint-fail|quiesce-audio-fail|quiesce-input-fail|quiesce-radios-fail|resume-radios-fail|resume-input-fail|resume-audio-fail|hal-loss|arm-fail|verify-fail|clear-fail|crash-before-suspend|crash-armed-journal|shutdown-fail|deadline) ;; *) usage ;; esac ;;
        adapter)
            case "$1" in complete|fail|exit|crash) ;; *) usage ;; esac
            shift
            while [ "$#" -gt 0 ]; do
                [ "$#" -ge 2 ] || usage
                case "$1" in
                    --status) case "$2" in ''|*[!0-9]*) usage ;; esac; [ "$2" -le 255 ] || usage ;;
                    --value)
                        case "$2" in -[0-9]*|+[0-9]*|[0-9]*) ;; *) usage ;; esac
                        case "$2" in *[!0-9+-]*) usage ;; esac ;;
                    *) usage ;;
                esac
                shift 2
            done ;;
        presentation)
            [ "$#" -eq 2 ] && [ "$1" = --action ] || usage
            case "$2" in
                home|systems|games|games-no-metadata|favorites|recent|resume|favorite|media-details|theme-garden|update|unavailable|search|settings|settings-form|recovery|modal|scraper-settings|scraper-game|scraper-queue|scraper-progress|scraper-progress-zero|scraper-progress-2|scraper-progress-4|scraper-fallback|scraper-background|scraper-paused|scraper-resumed|scraper-ambiguity|scraper-complete|scraper-cancel|scraper-confirm-cancel|wifi-scan|wifi-access-points|wifi-password|wifi-hidden|wifi-manual|wifi-progress|wifi-error|save-vault-history|save-vault-preview|save-vault-confirm|save-vault-restore|save-vault-cancel|fallback) ;;
                *) usage ;;
            esac ;;
        screenshot|checkpoint)
            [ "$#" -eq 2 ] && [ "$1" = --name ] || usage
            validate_name "$2" ;;
        save-vault.history|save-vault.preview)
            [ "$#" -eq 0 ] || usage ;;
        save-sync.status) [ "$#" -eq 0 ] || usage ;;
        save-sync.resolve)
            [ "$#" -eq 2 ] && [ "$1" = --action ] || usage
            case "$2" in keep-local|keep-remote|keep-both) ;; *) usage ;; esac ;;
        save-vault.restore)
            [ "$#" -eq 2 ] && [ "$1" = --confirmed ] || usage
            validate_bool "$2" ;;
        autosave)
            [ "$#" -ge 2 ] && [ "$1" = --reason ] || usage
            case "$2" in normal-exit|pre-suspend|low-battery|periodic) ;; *) usage ;; esac
            shift 2
            while [ "$#" -gt 0 ]; do
                [ "$#" -ge 2 ] && [ "$1" = --fault ] || usage
                case "$2" in none|artifact|metadata|promotion|pointer) ;; *) usage ;; esac
                shift 2
            done ;;
        resume)
            [ "$#" -ge 4 ] && [ "$1" = --content-id ] && [ "$3" = --decision ] || usage
            case "$2" in nebula-nes|mirror-ps1|orbit-garden|signal-workshop) ;; *) usage ;; esac
            case "$4" in resume|retained-matching-core|cold-start-sram|restore-previous|fresh-start|cancel) ;; *) usage ;; esac
            shift 4
            while [ "$#" -gt 0 ]; do
                [ "$#" -ge 2 ] || usage
                case "$1" in
                    --runner-id|--core-id) validate_name "$2" ;;
                    --runner-version|--core-version) validate_version "$2" ;;
                    *) usage ;;
                esac
                shift 2
            done ;;
        resume.delete)
            [ "$#" -eq 6 ] && [ "$1" = --content-id ] && [ "$3" = --generation ] && [ "$5" = --confirmed ] || usage
            case "$2" in nebula-nes|mirror-ps1|orbit-garden|signal-workshop) ;; *) usage ;; esac
            case "$4" in ''|*[!0-9]*) usage ;; esac
            validate_bool "$6" ;;
        clock)
            [ "$#" -eq 3 ] && { [ "$2" = --minutes ] || [ "$2" = --milliseconds ]; } || usage
            case "$1" in advance|jump) ;; *) usage ;; esac
            case "$3" in ''|*[!0-9]*) usage ;; esac
            if [ "$2" = --minutes ]; then [ "$3" -le 60 ] || usage; else [ "$3" -le 3600000 ] || usage; fi ;;
        lifecycle)
            [ "$#" -ge 3 ] && [ "$2" = --timeout ] || usage
            case "$1" in suspend|resume|shutdown) ;; *) usage ;; esac
            case "$3" in ''|*[!0-9]*) usage ;; esac
            [ "$3" -gt 0 ] && [ "$3" -le 30 ] || usage
            shift 3
            while [ "$#" -gt 0 ]; do
                [ "$#" -ge 2 ] || usage
                case "$1" in
                    --duration-minutes) case "$2" in 1|5|10|15|30|60) ;; *) usage ;; esac ;;
                    --source) case "$2" in user|deadline|stale-alarm) ;; *) usage ;; esac ;;
                    *) usage ;;
                esac
                shift 2
            done ;;
        tg4040)
            case "$1:$#" in
                led:3) [ "$2" = --enabled ] && validate_bool "$3" || usage ;;
                led:5) [ "$2" = --enabled ] && validate_bool "$3" && [ "$4" = --brightness-percent ] && case "$5" in ''|*[!0-9]*) false ;; *) [ "$5" -le 100 ] ;; esac || usage ;;
                rumble:3) [ "$2" = --active ] && validate_bool "$3" || usage ;;
                low-battery:3) [ "$2" = --active ] && validate_bool "$3" || usage ;;
                input:3) [ "$2" = --signal ] && [ "$3" = gpio243 ] || usage ;;
                scan:3) [ "$2" = --role ] && { [ "$3" = controller ] || [ "$3" = audio ]; } || usage ;;
                pair:1|paired:1|connected:1|reconnect:1|reboot:1|reset:1) ;;
                *) usage ;;
            esac ;;
        *) usage ;;
    esac
}

run_client() {
    status=0
    output=$(docker_with_timeout exec --user 10001:10001 "$NAME" /usr/local/bin/sim-control --socket /evidence/control.sock "$@" 2>/dev/null) || status=$?
    status=${status:-0}
    if [ "$status" -eq 124 ]; then
        if docker_with_timeout rm -f "$NAME" >/dev/null 2>&1; then
            rm -f "$SOCKET"
            emit_error timeout "control request timed out; simulator was removed" 5
        fi
        emit_error timeout "control request timed out; run scripts/sim clean-run to remove the simulator" 5
    fi
    if [ -z "$output" ]; then
        emit_error unavailable "control client is unavailable" 3
    fi
    printf '%s\n' "$output" | python3 -c 'import json, sys; json.loads(sys.stdin.read())' >/dev/null 2>&1 \
        || emit_error transport "malformed control response" 5
    printf '%s\n' "$output"
    return "$status"
}

command=$1
shift
validate_command "$command" "$@"
if ! verify_container; then
    emit_error unavailable "named simulator container is unavailable, unresponsive, or does not own this run directory; run scripts/sim clean-run" 3
fi

if [ "$command" = wait-ready ]; then
    timeout=$2
    elapsed=0
    while [ "$elapsed" -lt "$timeout" ]; do
        if [ -S "$SOCKET" ]; then
            status=0
            run_client "$command" "$@" || status=$?
            case "$status" in
                0) exit 0 ;;
                3) ;;
                *) exit "$status" ;;
            esac
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    emit_error timeout "wait-ready timed out" 5
fi
[ -S "$SOCKET" ] || emit_error unavailable "control socket is unavailable" 3
run_client "$command" "$@"
