{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-launch-catalog-v1.schema.json",
  "title": "Brick Pro launch catalog projection v1",
  "description": "Closed, versioned allowlist projection for LaunchRequest validation. It is not package-signature verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "runners", "cores", "profiles"],
  "properties": {
    "$schema": {"const": "https://example.invalid/trimui-launch-catalog-v1.schema.json"},
    "format": {"const": "brickpro-launch-catalog"},
    "schemaVersion": {"const": 1},
    "runners": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/runner"}
    },
    "cores": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/core"}
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "kind": {"enum": ["libretro", "standalone", "port"]},
    "capability": {"enum": ["display-basic", "input-standard", "input-arcade", "rumble", "suspend", "battery-saver"]},
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kinds", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "kinds": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/kind"}},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}
      }
    },
    "core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "runnerId", "runnerVersion", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/version"},
        "runnerId": {"$ref": "#/$defs/identifier"},
        "runnerVersion": {"$ref": "#/$defs/version"},
        "kind": {"const": "libretro"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}
      }
    }
  }
}
