{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-fixture-v1",
  "title": "Artbook UI journey fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "journey", "generated", "actions", "expected"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "journey": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9-]+$" },
    "generated": { "const": true },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-zA-Z0-9-]+$" },
          "target": { "type": "string", "minLength": 1, "maxLength": 80 },
          "value": { "type": "string", "maxLength": 160 },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "route", "assertion"],
      "properties": {
        "identity": { "const": "Artbook" },
        "route": { "type": "string", "minLength": 1, "maxLength": 48, "pattern": "^[a-z0-9-]+$" },
        "selection": { "type": "string", "maxLength": 80 },
        "status": { "type": "string", "maxLength": 80 },
        "assertion": { "type": "string", "minLength": 1, "maxLength": 240 },
        "capability": { "type": "string", "maxLength": 48 }
      }
    }
  }
}
