#!/usr/bin/env python3
"""Validate the closed, ordinary compatibility-recipe JSON fixtures."""
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
FIXTURES = ROOT / "fixtures/compatibility-recipes/generated-v1"
SCHEMA = ROOT / "schemas/compat-recipe-v1.schema.json"
BANNED_KEYS = {"artifact", "argv", "bytes", "command", "executable", "package", "path", "payload", "script", "shell", "url"}


def load(path: Path) -> object:
    return json.loads(path.read_text(encoding="utf-8"))


def walk(value: object) -> None:
    if isinstance(value, dict):
        banned = BANNED_KEYS.intersection(value)
        if banned:
            raise SystemExit(f"recipe contains payload-shaped field: {sorted(banned)}")
        for child in value.values():
            walk(child)
    elif isinstance(value, list):
        for child in value:
            walk(child)


def main() -> None:
    schema = load(SCHEMA)
    if schema.get("additionalProperties") is not False:
        raise SystemExit("recipe schema is not closed")
    for path in sorted((FIXTURES / "recipes").glob("*.json")):
        recipe = load(path)
        walk(recipe)
        if len(path.read_bytes()) > 256 * 1024:
            raise SystemExit(f"recipe exceeds size bound: {path}")
    print("compatibility-recipes JSON/schema checks passed")


if __name__ == "__main__":
    main()
