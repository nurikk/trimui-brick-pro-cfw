{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-brick-package-v1.schema.json",
  "title": "Brick Pro package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": "https://example.invalid/trimui-brick-package-v1.schema.json"
    },
    "format": {
      "const": "brickpro-package"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 32
    },
    "targetSku": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$",
      "maxLength": 64
    },
    "targetAbi": {
      "const": "aarch64-unknown-linux-musl"
    },
    "type": {
      "enum": [
        "package",
        "theme",
        "recipe",
        "core",
        "portmaster",
        "module",
        "application",
        "utility"
      ]
    },
    "builtinEntrypoint": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "dependencies": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredBytes", "userData"],
      "properties": {
        "requiredBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "userData": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^writable/(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$"}
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+$",
            "maxLength": 240
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "length": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048576
          },
          "class": {
            "enum": [
              "immutable",
              "writable",
              "runtime",
              "cache"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "length",
          "class"
        ]
      }
    },
    "entrypoints": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "mode": {
            "enum": [
              "data-only",
              "0755"
            ]
          }
        },
        "required": [
          "name",
          "path",
          "mode"
        ]
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "runtime"
        },
        "dependencies": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      },
      "required": [
        "path",
        "dependencies"
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preserve": {
          "oneOf": [
            {
              "const": [
                "/roms",
                "/data/saves",
                "/data/states"
              ]
            },
            {
              "const": [
                "/roms",
                "/data/saves",
                "/data/states",
                "/data/resume"
              ]
            },
            {
              "const": [
                "/roms",
                "/data/saves",
                "/data/states",
                "/data/resume",
                "/data/settings",
                "/.brickpro/save-vault"
              ]
            }
          ]
        },
        "remove": {
          "const": [
            "immutable",
            "runtime",
            "cache",
            "staging"
          ]
        }
      },
      "required": [
        "preserve",
        "remove"
      ]
    },
    "corePack": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "blocked"
        },
        "blockedReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      },
      "required": [
        "status",
        "blockedReason"
      ]
    }
  },
  "required": [
    "$schema",
    "format",
    "schemaVersion",
    "id",
    "version",
    "targetSku",
    "type",
    "files",
    "entrypoints",
    "runtime",
    "capabilities",
    "uninstall"
  ],
  "$defs": {
    "capabilities": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://example.invalid/trimui-brick-capabilities-v1.schema.json",
      "title": "Brick Pro package capabilities v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "https"
            ]
          }
        },
        "input": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "buttons"
            ]
          }
        },
        "audio": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "playback"
            ]
          }
        },
        "display": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "overlay"
            ]
          }
        },
        "save": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "filesystem": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["package-data"]}
        }
      },
      "required": [
        "network",
        "input",
        "audio",
        "display",
        "save"
      ]
    }
  }
}
