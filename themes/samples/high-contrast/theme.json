{
  "$schema": "urn:project:theme-v1",
  "canvas": {
    "aspect": "4:3",
    "height": 768,
    "width": 1024
  },
  "colors": {
    "accent": "#0055FF",
    "background": "#000000",
    "highlight": "#FFFF00",
    "muted": "#404040",
    "surface": "#181818",
    "text": "#FFFFFF"
  },
  "fallback": {
    "onInvalid": "safe-artbook",
    "splash": "generated-neutral"
  },
  "format": "theme-v1",
  "layout": {
    "maxVisibleGames": 10,
    "preset": "contrast",
    "regions": [
      {
        "height": 260,
        "id": "system-art",
        "kind": "system-art",
        "visible": true,
        "width": 390,
        "x": 20,
        "y": 68
      },
      {
        "height": 260,
        "id": "game-list",
        "kind": "game-list",
        "visible": true,
        "width": 574,
        "x": 430,
        "y": 68
      },
      {
        "height": 200,
        "id": "box-art",
        "kind": "box-art-placeholder",
        "visible": true,
        "width": 190,
        "x": 20,
        "y": 350
      },
      {
        "height": 164,
        "id": "screenshot",
        "kind": "screenshot-placeholder",
        "visible": true,
        "width": 290,
        "x": 230,
        "y": 350
      },
      {
        "height": 200,
        "id": "metadata",
        "kind": "metadata",
        "visible": true,
        "width": 464,
        "x": 540,
        "y": 350
      },
      {
        "height": 90,
        "id": "menu",
        "kind": "menu",
        "visible": true,
        "width": 984,
        "x": 20,
        "y": 580
      },
      {
        "height": 40,
        "id": "help",
        "kind": "help-strip",
        "visible": true,
        "width": 720,
        "x": 20,
        "y": 696
      },
      {
        "height": 40,
        "id": "clock",
        "kind": "clock",
        "visible": true,
        "width": 100,
        "x": 770,
        "y": 10
      },
      {
        "height": 40,
        "id": "battery",
        "kind": "battery",
        "visible": true,
        "width": 120,
        "x": 884,
        "y": 10
      }
    ]
  },
  "metadata": {
    "author": "Project Authors",
    "license": "MIT",
    "name": "High Contrast"
  },
  "resources": {
    "background": {
      "budgetBytes": 0,
      "kind": "generated",
      "ref": "grid-gradient"
    },
    "font": {
      "budgetBytes": 0,
      "kind": "builtin",
      "ref": "generated-sans"
    },
    "icon": {
      "budgetBytes": 0,
      "kind": "generated",
      "ref": "controller-mark"
    },
    "sound": {
      "budgetBytes": 0,
      "kind": "builtin",
      "ref": "silent"
    }
  },
  "schemaVersion": 1,
  "settings": {
    "artworkMode": "box-art",
    "colorScheme": "high-contrast",
    "fontScale": 120,
    "metadataVisibility": "full"
  }
}
