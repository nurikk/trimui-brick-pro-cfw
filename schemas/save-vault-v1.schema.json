{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-save-vault-v1.schema.json",
  "title": "Brick Pro Save Vault generation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "generation", "parentGeneration", "contentVersion", "runnerVersion", "coreVersion", "reason", "timestampMs", "anomaly", "retention", "artifacts"],
  "properties": {
    "$schema": {"const": "https://example.invalid/trimui-save-vault-v1.schema.json"},
    "format": {"const": "brickpro-save-vault"},
    "schemaVersion": {"const": 1},
    "generation": {"type": "integer", "minimum": 1},
    "parentGeneration": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1}]},
    "contentVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "runnerVersion": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "coreVersion": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"}]},
    "reason": {"enum": ["normal-exit", "pre-package", "pre-update", "pre-core-change", "pre-recipe", "pre-sync", "pre-restore"]},
    "timestampMs": {"type": "integer", "minimum": 1},
    "anomaly": {"enum": ["valid", "quarantined"]},
    "retention": {"enum": ["recent", "protected"]},
    "artifacts": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["contentId", "kind", "sourceRelative", "size", "sha256", "object"],
      "properties": {
        "contentId": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "kind": {"enum": ["sram", "save", "state", "declared-state"]},
        "sourceRelative": {"type": "string", "pattern": "^[^/\\\\.][^/\\\\]*(/[^/\\\\.][^/\\\\]*)*$", "maxLength": 255},
        "size": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "object": {"type": "string", "pattern": "^[0-9a-f]{64}\\.bin$"}
      }
    }
  }
}
