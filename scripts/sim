#!/bin/sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)

fail() {
    printf '%s\n' "sim: $*" >&2
    exit 2
}

command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is required"
. "$ROOT/scripts/docker-worktree.sh"
DOCKER_NAMESPACE=$(trimui_docker_namespace "$ROOT") || fail "invalid Docker namespace"
ROOT_FINGERPRINT=$(trimui_root_fingerprint "$ROOT") || fail "cannot fingerprint repository root"
SOURCE_FINGERPRINT=$(trimui_checkout_fingerprint "$ROOT") || fail "cannot fingerprint checkout"
IMAGE=trimui-brick-pro-cfw-simulator:${DOCKER_NAMESPACE}
SIMULATOR_LABEL=org.trimui-brick-pro-cfw.simulator=host-native
WORKTREE_LABEL=org.trimui-brick-pro-cfw.worktree=${DOCKER_NAMESPACE}
ROOT_LABEL=org.trimui-brick-pro-cfw.worktree-root-sha256=${ROOT_FINGERPRINT}
SOURCE_LABEL=org.trimui-brick-pro-cfw.source-sha256=${SOURCE_FINGERPRINT}
CACHE_LABEL=org.trimui-brick-pro-cfw.cache-scope=${DOCKER_NAMESPACE}

usage() {
    printf '%s\n' "usage: scripts/sim build | run [--backend=x11|dummy] [--catalog PATH] --run-dir DIR [--wait-ready SECONDS] [--detach] | stop --run-dir DIR | clean-run RUN_OPTIONS | lifecycle-journey" >&2
    exit 2
}

require_run_dir() {
    if [ -z "${RUN_DIR:-}" ]; then
        fail "--run-dir is required"
    fi
    case "$RUN_DIR" in
        /*) ;;
        *) fail "--run-dir must be an absolute path" ;;
    esac
    [ -d "$RUN_DIR" ] || fail "--run-dir must already exist"
    RUN_REAL=$(CDPATH= cd -- "$RUN_DIR" && pwd -P) || fail "cannot resolve --run-dir"
    [ "$RUN_REAL" != / ] || fail "--run-dir cannot be /"
    case "$RUN_REAL" in
        "$ROOT"|"$ROOT"/*) fail "--run-dir must be outside the repository" ;;
    esac
    [ ${#RUN_REAL} -le 87 ] || fail "--run-dir is too long for control.sock; use a shorter path"
}

container_name() {
    printf '%s' "$RUN_REAL" | cksum | awk -v docker_ns="$DOCKER_NAMESPACE" '{print "trimui-sim-" docker_ns "-" $1}'
}

reject_stale_evidence() {
    for artifact in \
        readiness.json route-selection.json launch.json launch-request.json session.json exit-status.json control.sock \
        .readiness.json.tmp .route-selection.json.tmp .launch.json.tmp .launch-request.json.tmp \
        .session.json.tmp .exit-status.json.tmp logs/launcher.jsonl; do
        [ ! -e "$RUN_REAL/$artifact" ] || fail "--run-dir contains existing simulator evidence: $artifact"
    done
    for directory in screenshots checkpoints; do
        if [ -d "$RUN_REAL/$directory" ] && find "$RUN_REAL/$directory" -type f -print -quit | grep -q .; then
            fail "--run-dir contains existing simulator evidence: $directory"
        fi
    done
}

verify_labels() {
    docker inspect "$NAME" 2>/dev/null | python3 -c '
import json, os, sys
try:
    record = json.load(sys.stdin)[0]
    for label in sys.argv[2:]:
        label_key, label_value = label.split("=", 1)
        if record.get("Config", {}).get("Labels", {}).get(label_key) != label_value: raise ValueError
    mounts = [mount for mount in record.get("Mounts", []) if mount.get("Destination") == "/evidence"]
    if len(mounts) != 1 or os.path.realpath(mounts[0].get("Source", "")) != os.path.realpath(sys.argv[1]): raise ValueError
except (IndexError, OSError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
' "$RUN_REAL" "$SIMULATOR_LABEL" "$WORKTREE_LABEL" "$ROOT_LABEL" "$CACHE_LABEL" "$@"
}

verify_container() { verify_labels "$SOURCE_LABEL"; }
verify_owned_container() { verify_labels; }

verify_running_container() {
    verify_container && docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null | grep -q '^true$'
}

json_readiness_valid() {
    python3 - "$RUN_REAL/readiness.json" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as stream:
        record = json.load(stream)
    if set(record) != {"schema", "lane", "targetSku", "runId", "ready", "elapsedMs", "reason"}:
        raise ValueError
    if record["schema"] != "sim-readiness/v1":
        raise ValueError
    if record["lane"] != "host-native userspace simulator":
        raise ValueError
    if type(record["runId"]) is not str or not record["runId"].startswith("run-"):
        raise ValueError
    if record["targetSku"] != "TG4040" or record["ready"] is not True:
        raise ValueError
    if type(record["elapsedMs"]) is not int or record["elapsedMs"] < 0:
        raise ValueError
    if record["reason"] != "ready":
        raise ValueError
except (OSError, ValueError, TypeError, json.JSONDecodeError):
    raise SystemExit(1)
PY
}

json_first_frame_valid() {
    python3 - "$RUN_REAL/logs/launcher.jsonl" <<'PY'
import json
import sys

try:
    previous_sequence = -1
    run_id = None
    with open(sys.argv[1], encoding="utf-8") as stream:
        for line in stream:
            record = json.loads(line)
            if not isinstance(record, dict):
                raise ValueError
            sequence = record["sequence"]
            at_ms = record["atMs"]
            if run_id is None:
                run_id = record["runId"]
            if (type(sequence) is not int or sequence < 0 or sequence <= previous_sequence
                    or type(at_ms) is not int or at_ms < 0
                    or record["runId"] != run_id
                    or record["lane"] != "host-native userspace simulator"):
                raise ValueError
            previous_sequence = sequence
            if record["event"] == "first_frame":
                raise SystemExit(0)
except (OSError, KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit(2)
raise SystemExit(1)
PY
}

startup_failure() {
    printf '%s\n' "sim: $1" >&2
    docker logs "$NAME" >&2 || true
    if verify_owned_container; then
        docker rm -f "$NAME" >/dev/null 2>&1 || true
    fi
    exit 1
}

parse_run_options() {
    BACKEND=dummy
    WAIT_READY=10
    DETACH=0
    CATALOG=sim/fixtures/catalog.json
    PROFILE=sim/device/tg4040-host.json
    RUN_DIR=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --backend=x11) BACKEND=x11 ;;
            --backend=dummy) BACKEND=dummy ;;
            --backend=*) fail "backend must be x11 or dummy" ;;
            --run-dir)
                shift
                [ "$#" -gt 0 ] || fail "missing --run-dir value"
                RUN_DIR=$1
                ;;
            --run-dir=*) RUN_DIR=${1#--run-dir=} ;;
            --catalog)
                shift
                [ "$#" -gt 0 ] || fail "missing --catalog value"
                CATALOG=$1
                ;;
            --catalog=*) CATALOG=${1#--catalog=} ;;
            --profile)
                shift
                [ "$#" -gt 0 ] || fail "missing --profile value"
                PROFILE=$1
                ;;
            --profile=*) PROFILE=${1#--profile=} ;;
            --wait-ready)
                shift
                [ "$#" -gt 0 ] || fail "missing --wait-ready value"
                WAIT_READY=$1
                ;;
            --wait-ready=*) WAIT_READY=${1#--wait-ready=} ;;
            --detach) DETACH=1 ;;
            *) fail "unknown run option: $1" ;;
        esac
        shift
    done
    case "$WAIT_READY" in
        ''|*[!0-9]*) fail "--wait-ready must be a positive integer" ;;
    esac
    [ "$WAIT_READY" -gt 0 ] || fail "--wait-ready must be a positive integer"
    require_run_dir
}

build() {
    [ "$#" -eq 0 ] || usage
    docker build --platform linux/amd64 \
        --build-arg "DOCKER_CACHE_SCOPE=$DOCKER_NAMESPACE" \
        --label "$WORKTREE_LABEL" \
        --label "$ROOT_LABEL" \
        --label "$SOURCE_LABEL" \
        --label "$CACHE_LABEL" \
        -f "$ROOT/containers/simulator/Dockerfile" -t "$IMAGE" "$ROOT"
}

run_sim() {
    parse_run_options "$@"
    reject_stale_evidence
    command -v python3 >/dev/null 2>&1 || fail "python3 is required for structural evidence validation"
    IMAGE_IDENTITY=$(docker image inspect "$IMAGE" --format '{{ index .Config.Labels "org.trimui-brick-pro-cfw.worktree" }}|{{ index .Config.Labels "org.trimui-brick-pro-cfw.worktree-root-sha256" }}|{{ index .Config.Labels "org.trimui-brick-pro-cfw.source-sha256" }}|{{ index .Config.Labels "org.trimui-brick-pro-cfw.cache-scope" }}' 2>/dev/null) \
        || fail "image is missing; run ./scripts/sim build first"
    [ "$IMAGE_IDENTITY" = "$DOCKER_NAMESPACE|$ROOT_FINGERPRINT|$SOURCE_FINGERPRINT|$DOCKER_NAMESPACE" ] \
        || fail "simulator image is stale, foreign, or missing exact checkout labels; run ./scripts/sim build first"
    NAME=$(container_name)
    chmod 0777 "$RUN_REAL" || fail "--run-dir must be writable"
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        verify_container || fail "existing container is not the simulator for --run-dir"
        docker rm -f "$NAME" >/dev/null 2>&1 || fail "cannot remove existing simulator container"
    fi
    set -- --backend="$BACKEND"
    case "$CATALOG" in
        *..*) fail "--catalog may not contain .." ;;
        sim/*.json) ;;
        *) fail "--catalog must be a repository sim JSON fixture" ;;
    esac
    [ -f "$ROOT/$CATALOG" ] || fail "catalog fixture does not exist"
    case "$PROFILE" in
        *..*) fail "--profile may not contain .." ;;
        sim/*.json) ;;
        *) fail "--profile must be a repository sim JSON fixture" ;;
    esac
    [ -f "$ROOT/$PROFILE" ] || fail "profile fixture does not exist"
    set -- "$@" --catalog "/src/$CATALOG" --profile "/src/$PROFILE"
    [ "$DETACH" -eq 1 ] && set -- "$@" --keep-alive
    docker run -d \
        --name "$NAME" \
        --label "$SIMULATOR_LABEL" \
        --label "$WORKTREE_LABEL" \
        --label "$ROOT_LABEL" \
        --label "$SOURCE_LABEL" \
        --label "$CACHE_LABEL" \
        --platform linux/amd64 \
        --network none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --pids-limit=64 \
        --user 10001:10001 \
        --mount "type=bind,src=$ROOT,dst=/src,readonly" \
        --mount "type=bind,src=$RUN_REAL,dst=/evidence" \
        --tmpfs /tmp:rw,nosuid,nodev,noexec,size=64m \
        "$IMAGE" "$@" >/dev/null

    elapsed=0
    ready=0
    first_frame=0
    while [ "$elapsed" -lt "$WAIT_READY" ]; do
        if [ -f "$RUN_REAL/readiness.json" ]; then
            json_readiness_valid || startup_failure "startup produced failed or malformed readiness"
            ready=1
        fi
        if [ "$ready" -eq 1 ] && [ -f "$RUN_REAL/logs/launcher.jsonl" ]; then
            frame_status=0
            json_first_frame_valid || frame_status=$?
            case "$frame_status" in
                0) first_frame=1; break ;;
                1) ;;
                *) startup_failure "launcher log is malformed" ;;
            esac
        fi
        if ! docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null | grep -q '^true$'; then
            if [ "$ready" -eq 1 ]; then
                startup_failure "container exited before first_frame"
            fi
            startup_failure "container exited before readiness"
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    if [ "$ready" -ne 1 ] || [ "$first_frame" -ne 1 ]; then
        startup_failure "readiness or first_frame timeout after ${WAIT_READY}s"
    fi
    if [ "$DETACH" -eq 1 ]; then
        return 0
    fi
    wait_output=
    wait_status=0
    wait_output=$(docker wait "$NAME") || wait_status=$?
    verify_container || fail "simulator container identity changed during run"
    docker rm "$NAME" >/dev/null 2>&1 || docker rm -f "$NAME" >/dev/null 2>&1 || true
    docker container inspect "$NAME" >/dev/null 2>&1 && fail "simulator container survived cleanup" || true
    [ "$wait_status" -eq 0 ] || fail "docker wait failed with status $wait_status"
    case "$wait_output" in
        ''|*[!0-9]*) fail "docker wait returned malformed exit code: $wait_output" ;;
    esac
    [ "$wait_output" -eq 0 ] || fail "simulator exited with status $wait_output"
}

stop_sim() {
    parse_run_options "$@"
    NAME=$(container_name)
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        verify_owned_container || fail "named container does not belong to --run-dir"
        if docker inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null | grep -q '^true$'; then
            if ! docker stop --time 10 "$NAME" >/dev/null; then
                docker rm -f "$NAME" >/dev/null 2>&1 || true
                fail "failed to stop simulator"
            fi
        fi
        docker rm "$NAME" >/dev/null 2>&1 || {
            docker rm -f "$NAME" >/dev/null 2>&1 || true
            fail "failed to remove simulator"
        }
    fi
    docker container inspect "$NAME" >/dev/null 2>&1 && fail "simulator container survived cleanup" || true
    [ ! -e "$RUN_REAL/control.sock" ] || fail "control socket was not removed during clean shutdown"
    [ -f "$RUN_REAL/logs/launcher.jsonl" ] || fail "launcher log is missing"
    grep -q '"event":"clean_shutdown"' "$RUN_REAL/logs/launcher.jsonl" \
        || fail "clean_shutdown was not recorded"
    grep -q '"exitCode":0' "$RUN_REAL/exit-status.json" \
        && grep -q '"cleanShutdown":true' "$RUN_REAL/exit-status.json" \
        || fail "clean exit status was not recorded"
}

clean_run() {
    parse_run_options "$@"
    NAME=$(container_name)
    if docker container inspect "$NAME" >/dev/null 2>&1; then
        verify_owned_container || fail "named container does not belong to --run-dir"
        docker rm -f "$NAME" >/dev/null 2>&1 || fail "failed to remove simulator"
    fi
    docker container inspect "$NAME" >/dev/null 2>&1 && fail "simulator container survived cleanup" || true
    rm -rf "$RUN_REAL/logs" "$RUN_REAL/screenshots" "$RUN_REAL/checkpoints" "$RUN_REAL/data" \
        "$RUN_REAL/readiness.json" "$RUN_REAL/route-selection.json" \
        "$RUN_REAL/launch.json" "$RUN_REAL/launch-request.json" "$RUN_REAL/session.json" "$RUN_REAL/exit-status.json" \
        "$RUN_REAL/.readiness.json.tmp" "$RUN_REAL/.route-selection.json.tmp" \
        "$RUN_REAL/.launch.json.tmp" "$RUN_REAL/.launch-request.json.tmp" "$RUN_REAL/.session.json.tmp" \
        "$RUN_REAL/.exit-status.json.tmp" \
        "$RUN_REAL/control.sock"
    run_sim "$@"
}

labeled_container_count() {
    docker ps -aq \
        --filter "label=$SIMULATOR_LABEL" \
        --filter "label=$WORKTREE_LABEL" |
        awk 'NF { count += 1 } END { print count + 0 }'
}

lifecycle_journey() {
    [ "$#" -eq 0 ] || usage
    [ "$(labeled_container_count)" -eq 0 ] || fail "lifecycle journey started with labeled simulator containers"
    first=$(mktemp -d "${TMPDIR:-/tmp}/trimui-sim-lifecycle.XXXXXX")
    second=$(mktemp -d "${TMPDIR:-/tmp}/trimui-sim-lifecycle.XXXXXX")
    cleanup() {
        for run in "$first" "$second"; do
            RUN_REAL=$(CDPATH= cd -- "$run" 2>/dev/null && pwd -P) || continue
            NAME=$(container_name)
            if docker container inspect "$NAME" >/dev/null 2>&1 && verify_owned_container; then
                docker rm -f "$NAME" >/dev/null 2>&1 || true
            fi
        done
        rm -rf "$first" "$second"
    }
    trap cleanup EXIT HUP INT TERM

    "$ROOT/scripts/sim" run --backend=dummy --run-dir "$first" --wait-ready 30 --detach
    [ -f "$first/data/launcher-state.json" ]
    [ -f "$first/data/rom-index.json" ]
    [ "$(stat -c '%a' "$first/data")" = 777 ] || fail "simulator data directory is not caller-cleanable"
    [ "$(stat -c '%a' "$first/control.sock")" = 660 ] || fail "control socket is world-writable"
    "$ROOT/scripts/sim" stop --backend=dummy --run-dir "$first" --wait-ready 30
    [ ! -e "$first/control.sock" ] || fail "control socket survived stop"
    rm -rf "$first"
    [ ! -e "$first" ] || fail "caller could not remove stopped simulator run"

    "$ROOT/scripts/sim" run --backend=dummy --run-dir "$second" --wait-ready 30 --detach
    RUN_REAL=$(CDPATH= cd -- "$second" && pwd -P)
    NAME=$(container_name)
    docker rm -f "$NAME" >/dev/null || fail "could not interrupt simulator journey"
    "$ROOT/scripts/sim" clean-run --backend=dummy --run-dir "$second" --wait-ready 30 --detach
    "$ROOT/scripts/sim" stop --backend=dummy --run-dir "$second" --wait-ready 30
    rm -rf "$second"
    [ ! -e "$second" ] || fail "caller could not remove clean-run simulator run"
    [ "$(labeled_container_count)" -eq 0 ] || fail "lifecycle cleanup left labeled simulator containers"
    printf '%s\n' "sim lifecycle journey passed: caller-cleanable state, interruption recovery, and zero labeled containers"
}

[ "$#" -gt 0 ] || usage
command=$1
shift
case "$command" in
    build) build "$@" ;;
    run) run_sim "$@" ;;
    stop) stop_sim "$@" ;;
    clean-run) clean_run "$@" ;;
    lifecycle-journey) lifecycle_journey "$@" ;;
    *) usage ;;
esac
