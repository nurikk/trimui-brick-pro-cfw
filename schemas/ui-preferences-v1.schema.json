{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ui-preferences-v1",
  "title": "Artbook persisted preferences",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "identity", "key", "preferences"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": { "const": "Artbook" },
    "key": { "const": "ui.preferences" },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artworkMode", "metadataVisibility", "uiSize", "colorScheme"],
      "properties": {
        "artworkMode": { "enum": ["large", "compact", "off"] },
        "metadataVisibility": { "enum": ["full", "compact", "hidden"] },
        "uiSize": { "enum": ["automatic", "compact", "normal", "comfortable", "large", "extra-large"] },
        "colorScheme": { "enum": ["ink", "paper", "high-contrast"] },
        "visualPreset": { "enum": ["default", "night-warm", "low-brightness", "pixel-accurate", "dense-list"] },
        "nightSchedule": { "enum": ["manual", "local-time"] }
      }
    }
  }
}
