{
  "$schema": "urn:project:theme-v1",
  "canvas": {
    "aspect": "4:3",
    "height": 768,
    "width": 1024
  },
  "colors": {
    "accent": "#4D83D8",
    "background": "#10131C",
    "highlight": "#F0B35B",
    "muted": "#56627A",
    "surface": "#202638",
    "text": "#EDF2FA"
  },
  "fallback": {
    "onInvalid": "safe-artbook",
    "splash": "generated-neutral"
  },
  "format": "theme-v1",
  "layout": {
    "maxVisibleGames": 8,
    "preset": "artbook",
    "regions": [
      {
        "height": 250,
        "id": "system-art",
        "kind": "system-art",
        "visible": true,
        "width": 360,
        "x": 32,
        "y": 72
      },
      {
        "height": 250,
        "id": "game-list",
        "kind": "game-list",
        "visible": true,
        "width": 572,
        "x": 420,
        "y": 72
      },
      {
        "height": 210,
        "id": "box-art",
        "kind": "box-art-placeholder",
        "visible": true,
        "width": 176,
        "x": 32,
        "y": 340
      },
      {
        "height": 158,
        "id": "screenshot",
        "kind": "screenshot-placeholder",
        "visible": true,
        "width": 280,
        "x": 224,
        "y": 340
      },
      {
        "height": 210,
        "id": "metadata",
        "kind": "metadata",
        "visible": true,
        "width": 464,
        "x": 528,
        "y": 340
      },
      {
        "height": 86,
        "id": "menu",
        "kind": "menu",
        "visible": true,
        "width": 960,
        "x": 32,
        "y": 580
      },
      {
        "height": 44,
        "id": "help",
        "kind": "help-strip",
        "visible": true,
        "width": 700,
        "x": 32,
        "y": 690
      },
      {
        "height": 36,
        "id": "clock",
        "kind": "clock",
        "visible": true,
        "width": 104,
        "x": 760,
        "y": 12
      },
      {
        "height": 36,
        "id": "battery",
        "kind": "battery",
        "visible": true,
        "width": 112,
        "x": 880,
        "y": 12
      }
    ]
  },
  "metadata": {
    "author": "Project Authors",
    "license": "MIT",
    "name": "Artbook"
  },
  "resources": {
    "background": {
      "budgetBytes": 0,
      "kind": "generated",
      "ref": "grid-gradient"
    },
    "font": {
      "budgetBytes": 0,
      "kind": "builtin",
      "ref": "generated-sans"
    },
    "icon": {
      "budgetBytes": 0,
      "kind": "generated",
      "ref": "controller-mark"
    },
    "sound": {
      "budgetBytes": 0,
      "kind": "builtin",
      "ref": "silent"
    }
  },
  "schemaVersion": 1,
  "settings": {
    "artworkMode": "system-art",
    "colorScheme": "dark",
    "fontScale": 100,
    "metadataVisibility": "full"
  }
}
