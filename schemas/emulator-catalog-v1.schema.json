{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-emulator-catalog-v1.schema.json",
  "title": "TrimUI Brick Pro clean-room emulator catalog v1",
  "description": "Closed declarative metadata only. It contains no emulator, BIOS, ROM, artwork, launcher, or firmware payload.",
  "oneOf": [
    {"$ref": "#/$defs/system"},
    {"$ref": "#/$defs/runner"},
    {"$ref": "#/$defs/core"},
    {"$ref": "#/$defs/profile"},
    {"$ref": "#/$defs/channel"}
  ],
  "$defs": {
    "header": {
      "type": "object",
      "required": ["$schema", "format", "schemaVersion", "kind"],
      "properties": {
        "$schema": {"const": "https://example.invalid/trimui-emulator-catalog-v1.schema.json"},
        "format": {"const": "trimui-emulator-catalog"},
        "schemaVersion": {"const": 1},
        "kind": {"type": "string"}
      }
    },
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "url": {"type": "string", "pattern": "^https://[^\\s]+$", "maxLength": 2048},
    "channelName": {"enum": ["stable", "experimental"]},
    "capability": {"enum": ["display", "audio", "input", "rumble", "save-state", "rewind"]},
    "path": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "relative"],
      "properties": {"root": {"enum": ["roms", "bios", "data/saves", "data/states"]}, "relative": {"type": "string", "minLength": 1, "maxLength": 4096}}
    },
    "ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}}
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["id", "sha256"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxWidth", "maxHeight", "maxControllers", "maxAudioChannels"],
      "properties": {"maxWidth": {"type": "integer", "minimum": 1}, "maxHeight": {"type": "integer", "minimum": 1}, "maxControllers": {"type": "integer", "minimum": 1}, "maxAudioChannels": {"type": "integer", "minimum": 1}}
    },
    "defaults": {
      "type": "object", "additionalProperties": false,
      "required": ["displayWidth", "displayHeight", "displayMode", "frameSkip", "rumble", "audioLatencyMs"],
      "properties": {"displayWidth": {"type": "integer", "minimum": 1}, "displayHeight": {"type": "integer", "minimum": 1}, "displayMode": {"enum": ["integer", "fit"]}, "frameSkip": {"type": "integer", "minimum": 0, "maximum": 10}, "rumble": {"type": "boolean"}, "audioLatencyMs": {"type": "integer", "minimum": 0}}
    },
    "bios": {
      "type": "object", "additionalProperties": false, "required": ["id", "expectedSha256", "locations"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "expectedSha256": {"$ref": "#/$defs/hash"}, "locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path"}}}
    },
    "system": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["$schema", "format", "schemaVersion", "kind", "id", "displayName", "targetSku", "channel", "extensions", "biosRequirements", "runtimeRequirements", "defaultRunner", "defaultCore", "savePath", "statePath", "capabilities", "deviceLimits", "settingsDefaults", "licenseProvenanceUrl"], "properties": {
          "kind": {"const": "system"}, "id": {"$ref": "#/$defs/id"}, "displayName": {"type": "string", "minLength": 1}, "targetSku": {"const": "TG4040"}, "channel": {"$ref": "#/$defs/channelName"},
          "extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+_-]{0,15}$"}},
          "biosRequirements": {"type": "array", "items": {"$ref": "#/$defs/bios"}}, "runtimeRequirements": {"type": "array", "items": {"type": "string"}}, "defaultRunner": {"$ref": "#/$defs/ref"}, "defaultCore": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}, "savePath": {"$ref": "#/$defs/path"}, "statePath": {"$ref": "#/$defs/path"}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}, "deviceLimits": {"$ref": "#/$defs/limits"}, "settingsDefaults": {"$ref": "#/$defs/defaults"}, "licenseProvenanceUrl": {"$ref": "#/$defs/url"}
        }}
      ],
      "unevaluatedProperties": false
    },
    "runner": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["$schema", "format", "schemaVersion", "kind", "id", "version", "targetArchitecture", "artifact", "supportedSystems", "supportedContent", "capabilities", "licenseProvenanceUrl", "channel"], "properties": {
          "kind": {"const": "runner"}, "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "targetArchitecture": {"const": "aarch64-unknown-linux-musl"}, "artifact": {"$ref": "#/$defs/artifact"}, "supportedSystems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "supportedContent": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}, "licenseProvenanceUrl": {"$ref": "#/$defs/url"}, "channel": {"$ref": "#/$defs/channelName"}
        }}
      ],
      "unevaluatedProperties": false
    },
    "core": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["$schema", "format", "schemaVersion", "kind", "id", "version", "runnerId", "runnerVersion", "supportedSystems", "supportedContent", "capabilities", "licenseProvenanceUrl", "channel"], "properties": {
          "kind": {"const": "core"}, "id": {"$ref": "#/$defs/id"}, "version": {"$ref": "#/$defs/version"}, "runnerId": {"$ref": "#/$defs/id"}, "runnerVersion": {"$ref": "#/$defs/version"}, "supportedSystems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}}, "supportedContent": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}, "licenseProvenanceUrl": {"$ref": "#/$defs/url"}, "channel": {"$ref": "#/$defs/channelName"}
        }}
      ],
      "unevaluatedProperties": false
    },
    "profile": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["$schema", "format", "schemaVersion", "kind", "id", "systemId", "capabilities", "channel"], "properties": {
          "kind": {"const": "profile"}, "id": {"$ref": "#/$defs/id"}, "systemId": {"$ref": "#/$defs/id"}, "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/capability"}}, "channel": {"$ref": "#/$defs/channelName"}
        }}
      ],
      "unevaluatedProperties": false
    },
    "channel": {
      "allOf": [
        {"$ref": "#/$defs/header"},
        {"type": "object", "required": ["$schema", "format", "schemaVersion", "kind", "id", "systems", "runners", "cores", "profiles", "smokeEvidenceId"], "properties": {
          "kind": {"const": "channel"}, "id": {"$ref": "#/$defs/channelName"}, "systems": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "runners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "cores": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}, "profiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "smokeEvidenceId": {"anyOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
        }}
      ],
      "unevaluatedProperties": false
    }
  }
}
