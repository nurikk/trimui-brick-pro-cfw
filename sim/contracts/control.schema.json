{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sim-control.schema.json",
  "title": "TG4040 simulator control protocol",
  "description": "Versioned JSON-lines semantic control protocol. It has no shell, process, path, mount, environment, or content fields.",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/state" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "command", "args"],
      "properties": {
        "version": { "const": "sim-control/v1" },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "command": { "enum": ["wait-ready", "state", "button", "action", "power", "hardware.set", "fault.set", "adapter", "presentation", "screenshot", "checkpoint", "autosave", "resume", "clock", "lifecycle", "save-vault.history", "save-vault.preview", "save-vault.restore"] },
        "args": { "type": "object" }
      },
      "allOf": [
        { "if": { "properties": { "command": { "const": "wait-ready" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/waitArgs" } } } },
        { "if": { "properties": { "command": { "const": "state" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/empty" } } } },
        { "if": { "properties": { "command": { "const": "button" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/buttonArgs" } } } },
        { "if": { "properties": { "command": { "const": "action" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/actionArgs" } } } },
        { "if": { "properties": { "command": { "const": "power" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/powerArgs" } } } },
        { "if": { "properties": { "command": { "const": "hardware.set" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/hardwareArgs" } } } },
        { "if": { "properties": { "command": { "const": "fault.set" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/faultArgs" } } } },
        { "if": { "properties": { "command": { "const": "adapter" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/adapterArgs" } } } },
        { "if": { "properties": { "command": { "const": "presentation" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/presentationArgs" } } } },
        { "if": { "properties": { "command": { "enum": ["screenshot", "checkpoint"] } } }, "then": { "properties": { "args": { "$ref": "#/$defs/artifactArgs" } } } },
        { "if": { "properties": { "command": { "const": "autosave" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/autosaveArgs" } } } },
        { "if": { "properties": { "command": { "const": "resume" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/resumeArgs" } } } },
        { "if": { "properties": { "command": { "const": "clock" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/clockArgs" } } } },
        { "if": { "properties": { "command": { "const": "lifecycle" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/lifecycleArgs" } } } },
        { "if": { "properties": { "command": { "const": "save-vault.history" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/empty" } } } },
        { "if": { "properties": { "command": { "const": "save-vault.preview" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/empty" } } } },
        { "if": { "properties": { "command": { "const": "save-vault.restore" } } }, "then": { "properties": { "args": { "$ref": "#/$defs/saveVaultRestoreArgs" } } } }

      ]
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "id", "ok", "result", "error"],
      "properties": {
        "version": { "const": "sim-control/v1" },
        "id": { "type": "string" },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "oneOf": [
            { "type": "null" },
            { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
          ]
        }
      }
    },
    "empty": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "waitArgs": { "type": "object", "additionalProperties": false, "required": ["timeoutMs"], "properties": { "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 } } },
    "buttonArgs": { "type": "object", "additionalProperties": false, "required": ["button", "action"], "properties": { "button": { "enum": ["l1", "r1", "up", "down", "left", "right", "primary", "secondary", "start", "select", "menu"] }, "action": { "enum": ["press", "release"] } } },
    "actionArgs": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "enum": ["jump-next-group", "jump-previous-group"] }, "phase": { "enum": ["press", "release"] } } },
    "powerArgs": { "type": "object", "additionalProperties": false, "required": ["operation"], "properties": { "operation": { "enum": ["override", "temperature", "battery-policy"] }, "profile": { "enum": ["eco", "balanced", "performance"] }, "temperatureC": { "type": "integer", "minimum": -20, "maximum": 150 }, "warningPercent": { "type": "integer", "minimum": 1, "maximum": 50 }, "criticalPercent": { "type": "integer", "minimum": 1, "maximum": 49 }, "lowBatteryAction": { "enum": ["warn-only", "save-and-exit", "exit-without-save"] }, "chargingLed": { "type": "boolean" }, "chargingDisplay": { "type": "boolean" } }, "allOf": [{ "if": { "properties": { "operation": { "const": "override" } } }, "then": { "required": ["profile"] } }, { "if": { "properties": { "operation": { "const": "temperature" } } }, "then": { "required": ["temperatureC"] } }, { "if": { "properties": { "operation": { "const": "battery-policy" } } }, "then": { "required": ["warningPercent", "criticalPercent", "lowBatteryAction", "chargingLed", "chargingDisplay"] } }] },
    "hardwareArgs": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "battery": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "available": { "type": "boolean" }, "percent": { "type": "integer", "minimum": 0, "maximum": 100 }, "charging": { "type": "boolean" }, "full": { "type": "boolean" }, "health": { "enum": ["good", "degraded", "unknown"] }, "externalPower": { "type": "boolean" } } },
        "storage": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "mode": { "enum": ["available", "full"] } } },
        "radio": { "type": "object", "additionalProperties": false, "minProperties": 1, "properties": { "enabled": { "type": "boolean" }, "connected": { "type": "boolean" } } }
      }
    },
    "state": {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "runId", "route", "selectedContentId", "activeSession", "lastSessionResult", "modal", "readinessGeneration", "sessionStep", "hardware", "platformState", "faults", "lifecycle", "clock", "power", "battery", "saveVault", "controllerRoute", "presentation"],
      "properties": {
        "schema": { "const": "sim-state/v1" },
        "runId": { "type": "string", "pattern": "^run-[0-9]+$" },
        "route": { "enum": ["library", "systems", "games", "catalog", "game-switcher", "session"] },
        "selectedContentId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
        "activeSession": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sessionHandle" }] },
        "lastSessionResult": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sessionResult" }] },
        "activeFakeSession": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["id", "contentId", "status", "exitStatus", "value"], "properties": { "id": { "type": "string" }, "contentId": { "type": "string" }, "status": { "enum": ["started", "completed", "failed", "crashed"] }, "exitStatus": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 255 }] }, "value": { "oneOf": [{ "type": "null" }, { "type": "integer" }] } } }] },
        "modal": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "readinessGeneration": { "type": "integer", "minimum": 1 },
        "sessionStep": { "type": "integer", "minimum": 0 },
        "hardware": { "$ref": "#/$defs/hardwareState" },
        "platformState": { "type": "object" },
        "faults": { "type": "array", "uniqueItems": true, "items": { "enum": ["adapter-fail", "adapter-crash", "input-drop", "suspend-fail", "checkpoint-fail", "quiesce-audio-fail", "quiesce-input-fail", "quiesce-radios-fail", "resume-radios-fail", "resume-input-fail", "resume-audio-fail", "hal-loss", "arm-fail", "verify-fail", "clear-fail", "crash-before-suspend", "crash-armed-journal", "shutdown-fail", "deadline"] } },
        "lifecycle": { "$ref": "#/$defs/lifecycleState" },
        "clock": { "type": "object", "additionalProperties": false, "required": ["monotonicMs", "wallClockMs"], "properties": { "monotonicMs": { "type": "integer", "minimum": 0 }, "wallClockMs": { "type": "integer", "minimum": 0 } } },
        "power": { "$ref": "#/$defs/powerState" },
        "battery": { "type": "object", "additionalProperties": false, "required": ["policy", "decision", "actionCount"], "properties": { "policy": { "type": "object" }, "decision": { "type": "object" }, "actionCount": { "type": "integer", "minimum": 0 } } },
        "saveVault": { "type": "object", "additionalProperties": false, "required": ["screen", "historyCount", "protectedCount", "preview", "confirmed"], "properties": { "screen": { "type": "string" }, "historyCount": { "type": "integer", "minimum": 0 }, "protectedCount": { "type": "integer", "minimum": 0 }, "preview": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/saveVaultPreview" }] }, "confirmed": { "type": "boolean" } } },
        "controllerRoute": { "type": "object", "additionalProperties": false, "required": ["navigatorVisible", "selectedIndex", "currentId", "expectedCount"], "properties": { "navigatorVisible": { "type": "boolean" }, "selectedIndex": { "type": "integer", "minimum": 0 }, "currentId": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" }] }, "expectedCount": { "type": "integer", "minimum": 1, "maximum": 128 } } },
        "presentation": { "type": "object", "additionalProperties": false, "required": ["schema", "identity", "route", "focus", "title", "selectedLabel", "menu", "gameRows", "resume", "selectedGame", "gameMedia", "systemMedia", "regions", "palette", "theme", "themeFallback", "generatedAssets", "settings", "wifi", "scraper", "modal", "splash", "affordances", "controllerHelp", "index", "boundaries", "groupJump", "saveSync", "uiSize"], "properties": { "schema": { "const": "launcher-presentation/v1" }, "identity": { "const": "Artbook" }, "route": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" }, "focus": { "type": "string", "pattern": "^[a-z0-9-]{1,48}$" }, "title": { "type": "string" }, "selectedLabel": { "type": "string" }, "uiSize": { "enum": ["automatic", "small", "medium", "large", "extra-large"] }, "menu": { "type": "array" }, "gameRows": { "type": "array" }, "resume": { "type": "array" }, "selectedGame": {}, "gameMedia": {"type": "array"}, "systemMedia": {}, "regions": { "type": "array", "minItems": 9 }, "palette": { "type": "object" }, "theme": { "type": "object" }, "themeFallback": {}, "generatedAssets": { "type": "array" }, "settings": {}, "wifi": {}, "scraper": { "type": "object" }, "modal": {}, "splash": { "type": "string" }, "affordances": { "type": "object" }, "controllerHelp": { "type": "array" }, "index": { "type": "object", "additionalProperties": false, "required": ["status", "entryCount", "visibleRows", "searchResults", "queueDepth"], "properties": { "status": { "type": "string" }, "entryCount": { "type": "integer" }, "visibleRows": { "type": "integer" }, "searchResults": { "type": "integer" }, "queueDepth": { "type": "integer" } } }, "groupJump": { "type": "object", "additionalProperties": false, "required": ["current", "target", "visible"], "properties": { "current": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 32 }] }, "target": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 32 }] }, "visible": { "type": "boolean" } } }, "boundaries": { "type": "object", "additionalProperties": false, "required": ["metadataScraper", "mediaCache", "wifiController", "themeGarden", "updateAgent"], "properties": { "metadataScraper": { "$ref": "#/$defs/boundary" }, "mediaCache": { "$ref": "#/$defs/boundary" }, "wifiController": { "$ref": "#/$defs/boundary" }, "themeGarden": { "$ref": "#/$defs/boundary" }, "updateAgent": { "$ref": "#/$defs/boundary" } } }, "saveSync": { "$ref": "#/$defs/saveSync" } } }
      }
    },
    "boundary": { "type": "object", "additionalProperties": false, "required": ["available", "state"], "properties": { "available": { "type": "boolean" }, "state": { "type": "string" } } },
    "saveSync": { "oneOf": [{ "type": "null" }, { "type": "object", "additionalProperties": false, "required": ["local", "remote", "state", "transportOutcome", "actions"], "properties": { "local": { "$ref": "#/$defs/saveSyncCandidate" }, "remote": { "$ref": "#/$defs/saveSyncCandidate" }, "state": { "type": "string" }, "transportOutcome": { "type": "string" }, "actions": { "type": "array", "items": { "enum": ["keep-local", "keep-remote", "keep-both"] } } } }] },
    "saveSyncCandidate": { "type": "object", "additionalProperties": false, "required": ["logicalId", "contentId", "deviceId", "deviceName", "generation", "hashPrefix", "parentHashPrefix", "ancestry", "saveKind", "timestampMs", "size", "status", "deleted"], "properties": { "logicalId": { "type": "string" }, "contentId": { "type": "string" }, "deviceId": { "type": "string" }, "deviceName": { "type": "string" }, "generation": { "type": "integer", "minimum": 1 }, "hashPrefix": { "type": "string", "minLength": 12, "maxLength": 12 }, "parentHashPrefix": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 12, "maxLength": 12 }] }, "ancestry": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 12, "maxLength": 12 } }, "saveKind": { "enum": ["sram", "save", "state", "declaredstate"] }, "timestampMs": { "type": "integer", "minimum": 1 }, "size": { "type": "integer", "minimum": 0 }, "status": { "type": "string" }, "deleted": { "type": "boolean" } } },
    "sessionHandle": {"type": "object", "additionalProperties": false, "required": ["schema", "sessionId", "contentId", "phase"], "properties": {"schema": {"const": "trimui-session-broker-handle/v1"}, "sessionId": {"type": "string"}, "contentId": {"type": "string"}, "phase": {"const": "active"} }},
    "sessionResult": {"type": "object", "additionalProperties": false, "required": ["type", "journey", "accepted", "runner", "core", "reason", "durationMs", "restored", "safeDefault", "persistenceStatus", "resumePublished"], "properties": {"type": {"const": "SessionResult"}, "journey": {"type": "string"}, "accepted": {"type": "boolean"}, "runner": {"oneOf": [{"type": "null"}, {"type": "string"}]}, "core": {"oneOf": [{"type": "null"}, {"type": "string"}]}, "reason": {"type": "string"}, "durationMs": {"type": "integer", "minimum": 0}, "restored": {"type": "boolean"}, "safeDefault": {"type": "boolean"}, "persistenceStatus": {"type": "string"}, "resumePublished": {"type": "boolean"}, "exitCode": {"type": "integer"}, "signal": {"type": "integer"} } },
    "saveVaultPreview": { "type": "object", "additionalProperties": false, "required": ["generation", "runnerVersion", "coreVersion", "oldSize", "newSize", "oldHashStatus", "newHashStatus", "oldHashPrefix", "newHashPrefix", "affectedKinds", "reason", "timestampMs"], "properties": { "generation": { "type": "integer", "minimum": 1 }, "runnerVersion": { "type": "string" }, "coreVersion": { "oneOf": [{ "type": "null" }, { "type": "string" }] }, "oldSize": { "type": "integer", "minimum": 0 }, "newSize": { "type": "integer", "minimum": 0 }, "oldHashStatus": { "type": "string" }, "newHashStatus": { "type": "string" }, "oldHashPrefix": { "type": "string", "pattern": "^[0-9a-f]{1,12}$" }, "newHashPrefix": { "type": "string", "pattern": "^(unavailable|[0-9a-f]{1,12})$" }, "affectedKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["sram", "save", "state", "declared-state"] } }, "reason": { "type": "string" }, "timestampMs": { "type": "integer", "minimum": 1 } } },
    "powerState": { "type": "object", "additionalProperties": false, "required": ["schema", "targetSku", "lane", "hardwareVerified", "realDeviceOperations", "globalDefault", "context", "requestedProfile", "effectiveProfile", "requestedSource", "effectiveSource", "temporaryGamePolicy", "safeModeReset", "temperatureC", "thermalLimitC", "thermalHysteresisC", "throttlingEnabled", "throttled", "policy"], "properties": { "schema": { "const": "tg4040-power-policies/v1" }, "targetSku": { "const": "TG4040" }, "lane": { "const": "host-native userspace simulator" }, "hardwareVerified": { "const": false }, "realDeviceOperations": { "const": "denied" }, "globalDefault": { "const": "balanced" }, "context": { "enum": ["launcher", "game", "suspend"] }, "requestedProfile": { "enum": ["eco", "balanced", "performance"] }, "effectiveProfile": { "enum": ["eco", "balanced", "performance"] }, "requestedSource": { "type": "string" }, "effectiveSource": { "type": "string" }, "temporaryGamePolicy": { "type": "boolean" }, "safeModeReset": { "type": "boolean" }, "temperatureC": { "type": "integer" }, "thermalLimitC": { "type": "integer" }, "thermalHysteresisC": { "type": "integer", "minimum": 1 }, "throttlingEnabled": { "const": true }, "throttled": { "type": "boolean" }, "policy": { "type": "object" } } },
    "lifecycleState": { "type": "object", "additionalProperties": false, "required": ["phase", "marker", "savedState", "journal", "armedDeadline", "wakeSource", "wakeReason", "shutdownRequest", "launchesAllowed", "backgroundAllowed"], "properties": { "phase": { "enum": ["awake", "preparing-suspend", "suspended", "resumed-by-user", "resumed-for-deadline", "orderly-shutdown", "recovery"] }, "marker": { "oneOf": [{ "type": "null" }, { "type": "object" }] }, "savedState": { "oneOf": [{ "type": "null" }, { "type": "object" }] }, "journal": { "type": "array", "maxItems": 64 }, "armedDeadline": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/wakeDeadline" }] }, "wakeSource": { "oneOf": [{ "type": "null" }, { "enum": ["user", "deadline", "stale-alarm"] }] }, "wakeReason": { "oneOf": [{ "type": "null" }, { "type": "string", "maxLength": 160 }] }, "shutdownRequest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/shutdownRequest" }] }, "launchesAllowed": { "type": "boolean" }, "backgroundAllowed": { "type": "boolean" } } },
    "wakeDeadline": { "type": "object", "additionalProperties": false, "required": ["token", "monotonicDeadlineMs", "bootTimeDeadlineMs", "durationMinutes"], "properties": { "token": { "type": "integer", "minimum": 1 }, "monotonicDeadlineMs": { "type": "integer", "minimum": 0 }, "bootTimeDeadlineMs": { "type": "integer", "minimum": 0 }, "durationMinutes": { "enum": [1, 5, 10, 15, 30, 60] } } },
    "shutdownRequest": { "type": "object", "additionalProperties": false, "required": ["reason", "status", "attempts"], "properties": { "reason": { "enum": ["arm-failure", "verify-failure", "alarm-clear-failure", "checkpoint-failure", "crash-before-suspend", "crash-with-armed-journal", "deadline", "hal-loss", "low-battery", "cold-recovery", "bounded-retry"] }, "status": { "enum": ["pending", "terminal", "failed"] }, "attempts": { "type": "integer", "minimum": 0, "maximum": 3 } } },
    "hardwareState": { "type": "object", "additionalProperties": false, "required": ["battery", "externalPower", "storage", "radio", "suspend"], "properties": { "battery": { "type": "object", "additionalProperties": false, "required": ["percent", "charging", "full", "health"], "properties": { "percent": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 100 }, { "type": "null" }] }, "charging": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] }, "full": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] }, "health": { "enum": ["good", "degraded", "unknown"] } } }, "externalPower": { "oneOf": [{ "type": "boolean" }, { "type": "null" }] }, "storage": { "type": "object", "additionalProperties": false, "required": ["mode"], "properties": { "mode": { "enum": ["available", "full"] } } }, "radio": { "type": "object", "additionalProperties": false, "required": ["enabled", "connected"], "properties": { "enabled": { "type": "boolean" }, "connected": { "type": "boolean" } } }, "suspend": { "type": "object", "additionalProperties": false, "required": ["state", "result"], "properties": { "state": { "enum": ["active", "suspended"] }, "result": { "enum": ["none", "success", "failed"] } } } } },
    "faultArgs": { "type": "object", "additionalProperties": false, "required": ["name", "enabled"], "properties": { "name": { "enum": ["adapter-fail", "adapter-crash", "input-drop", "suspend-fail", "checkpoint-fail", "quiesce-audio-fail", "quiesce-input-fail", "quiesce-radios-fail", "resume-radios-fail", "resume-input-fail", "resume-audio-fail", "hal-loss", "arm-fail", "verify-fail", "clear-fail", "crash-before-suspend", "crash-armed-journal", "shutdown-fail", "deadline"] }, "enabled": { "type": "boolean" } } },
    "adapterArgs": { "type": "object", "additionalProperties": false, "required": ["action", "status", "value"], "properties": { "action": { "enum": ["complete", "fail", "exit", "crash"] }, "status": { "type": "integer", "minimum": 0, "maximum": 255 }, "value": { "type": "integer", "minimum": -1000000, "maximum": 1000000 } } },
    "artifactArgs": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,47}$" } } },
    "autosaveArgs": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "enum": ["normal-exit", "pre-suspend", "low-battery", "periodic"] }, "fault": { "enum": ["none", "artifact", "metadata", "promotion", "pointer"] } } },
    "clockArgs": { "type": "object", "additionalProperties": false, "required": ["operation", "monotonicMs", "wallClockMs"], "properties": { "operation": { "enum": ["advance", "jump"] }, "monotonicMs": { "type": "integer", "minimum": 0 }, "wallClockMs": { "type": "integer", "minimum": 0 } } },
    "lifecycleArgs": { "type": "object", "additionalProperties": false, "required": ["operation", "timeoutMs"], "properties": { "operation": { "enum": ["suspend", "resume", "shutdown"] }, "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 30000 }, "durationMinutes": { "enum": [1, 5, 10, 15, 30, 60] }, "wakeSource": { "enum": ["user", "deadline", "stale-alarm"] } } },
    "resumeArgs": { "type": "object", "additionalProperties": false, "required": ["contentId", "decision"], "properties": { "contentId": { "enum": ["nebula-nes", "mirror-ps1", "orbit-garden", "signal-workshop"] }, "decision": { "enum": ["resume", "retained-matching-core", "cold-start-sram", "cancel"] }, "runnerId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,48}$" }, "runnerVersion": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,48}$" }, "coreId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,48}$" }, "coreVersion": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,48}$" } } },
    "saveVaultRestoreArgs": { "type": "object", "additionalProperties": false, "required": ["confirmed"], "properties": { "confirmed": { "type": "boolean" } } },
    "presentationArgs": { "type": "object", "additionalProperties": false, "required": ["action"], "properties": { "action": { "enum": ["home", "systems", "games", "games-no-metadata", "favorites", "recent", "resume", "favorite", "media-details", "theme-garden", "update", "unavailable", "search", "settings", "settings-form", "recovery", "modal", "scraper-settings", "scraper-game", "scraper-queue", "scraper-progress", "scraper-paused", "scraper-resumed", "scraper-ambiguity", "scraper-complete", "scraper-cancel", "wifi-scan", "wifi-access-points", "wifi-password", "wifi-hidden", "wifi-manual", "wifi-progress", "wifi-error", "save-vault-history", "save-vault-preview", "save-vault-confirm", "save-vault-restore", "save-vault-cancel", "fallback"] } } }
  }
}
