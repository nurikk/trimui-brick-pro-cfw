{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/trimui-tg4040-core-pack-journey-v1.schema.json",
  "title": "TG4040 generated synthetic core-pack journey v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "schemaVersion", "fixtureKind", "catalog", "cases"],
  "properties": {
    "$schema": {"const": "https://example.invalid/trimui-tg4040-core-pack-journey-v1.schema.json"},
    "format": {"const": "trimui-tg4040-core-pack-journey"},
    "schemaVersion": {"const": 1},
    "fixtureKind": {"const": "generated-synthetic-core-pack-journey"},
    "catalog": {"const": "catalog/core-packs/stable.json"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["systemId", "extension", "biosReady", "expectedCode"],
        "properties": {
          "systemId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "extension": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+_-]{0,15}$"},
          "biosReady": {"type": "boolean"},
          "expectedCode": {"enum": ["bios_missing", "core_pack_blocked", "extension_unavailable"]}
        }
      }
    }
  }
}
